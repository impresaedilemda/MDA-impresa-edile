# Copia in .env e riempi. Le stesse variabili si impostano anche su Vercel.

# Pannello di amministrazione e contenuti gestiti dal cliente.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Dominio definitivo. Comanda canonical, sitemap, robots.txt e security.txt.
PUBLIC_SITE_URL=https://www.mdaimpresaedile.it

# Invio delle email dei moduli, attraverso Resend (resend.com).
# Queste tre NON hanno il prefisso PUBLIC_ di proposito: restano sul server,
# dentro api/richiesta.ts, e non finiscono mai nel browser.
# Senza, i moduli mostrano un errore onesto e nessuna email parte.
RESEND_API_KEY=re_...
RICHIESTE_A=impresaedilemda@gmail.com
RICHIESTE_DA=Sito MDA Impresa Edile <sito@mdaimpresaedile.it>

# Google Analytics 4. LASCIARE VUOTO finche non si vuole davvero attivarlo.
#
# Appena questa variabile ha un valore, il sito accende da solo il banner del
# consenso: GA non viene caricato prima della scelta, il Consent Mode parte da
# "denied" e le pagine legali aggiungono le sezioni su Google Analytics.
# Senza la variabile non c'e nessun banner, perche non c'e niente da consentire.
PUBLIC_GA_ID=
