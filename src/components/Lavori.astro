---
/**
 * Portfolio scuro con coppie prima/dopo, come nel design.
 */
import { portfolio, portfolioSection, portfolioIsPlaceholder } from '../config/content'
import Icona from './Icona.astro'
---

<section id="lavori" class="scroll-mt-24 bg-nero py-16 text-white md:py-[120px]">
  <div class="contenitore flex flex-col gap-12 md:gap-20">
    <!-- Intestazione -->
    <div class="rivela flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex max-w-[680px] flex-col gap-4">
        <p class="occhiello !text-sabbia">{portfolioSection.eyebrow}</p>
        <h2 class="titolo-sezione !text-white">{portfolioSection.title}</h2>
      </div>
      <p class="max-w-[400px] font-sans leading-relaxed text-sabbia/80">{portfolioSection.intro}</p>
    </div>

    <!-- Progetti -->
    <div class="flex flex-col">
      {
        portfolio.map((progetto) => (
          <article class="rivela grid gap-8 border-b border-white/8 py-12 first:pt-0 xl:grid-cols-[auto_1fr] xl:gap-14">
            <!-- Coppia prima/dopo -->
            <div class="grid max-w-[720px] grid-cols-1 gap-6 sm:grid-cols-2">
              <figure class="zoom-foto flex flex-col gap-3 [&_img]:rounded-md">
                <figcaption class="font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-mattone">
                  {portfolioSection.beforeLabel}
                </figcaption>
                <img
                  src={progetto.before}
                  alt={`${progetto.title}, prima dell'intervento`}
                  width="700"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  class="aspect-square w-full rounded-md object-cover"
                />
              </figure>
              <figure class="zoom-foto flex flex-col gap-3 [&_img]:rounded-md">
                <figcaption class="font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-verde">
                  {portfolioSection.afterLabel}
                </figcaption>
                <img
                  src={progetto.after}
                  alt={`${progetto.title}, a lavoro concluso`}
                  width="700"
                  height="700"
                  loading="lazy"
                  decoding="async"
                  class="aspect-square w-full rounded-md object-cover"
                />
              </figure>
            </div>

            <!-- Dettagli -->
            <div class="flex flex-col justify-center gap-5">
              <span class="inline-flex items-center gap-2 self-start rounded-[4px] bg-white/7 px-3 py-1.5 font-sans text-xs font-semibold text-sabbia">
                <Icona nome="portfolio-map-pin" class="size-3.5" />
                {progetto.place}
              </span>

              <h3 class="font-display text-3xl font-normal leading-tight md:text-4xl">{progetto.title}</h3>
              <p class="max-w-[520px] font-sans text-[15px] leading-relaxed text-sabbia/85">{progetto.text}</p>

              <dl class="mt-2 grid grid-cols-2 gap-6 max-w-[520px]">
                <div class="flex flex-col gap-1">
                  <dt class="font-sans text-[11px] font-semibold uppercase tracking-[0.08em] text-sabbia/60">Tempo di posa</dt>
                  <dd class="font-sans text-[15px] font-bold text-white">{progetto.days}</dd>
                </div>
                <div class="flex flex-col gap-1">
                  <dt class="font-sans text-[11px] font-semibold uppercase tracking-[0.08em] text-sabbia/60">Materiali usati</dt>
                  <dd class="font-sans text-[15px] font-bold text-white">{progetto.materials}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))
      }
    </div>

    {
      portfolioIsPlaceholder && (
        <p class="rivela -mt-8 text-xs text-sabbia/40">
          Immagini illustrative, in attesa della documentazione fotografica dei cantieri.
        </p>
      )
    }

    {/* Promemoria visibile solo in sviluppo, non finisce mai in produzione */}
    {
      import.meta.env.DEV && portfolioIsPlaceholder && (
        <div class="border-l-4 border-red-500 bg-red-50 p-5 text-sm text-red-900">
          <strong class="font-semibold">Promemoria di sviluppo, non visibile in produzione.</strong>
          <br />
          Progetti e immagini del portfolio sono segnaposto generati. Vanno sostituiti con cantieri e foto
          reali prima della pubblicazione, poi impostare <code>portfolioIsPlaceholder = false</code> in
          <code>src/config/content.ts</code>. Presentare lavori non propri e pubblicità ingannevole.
        </div>
      )
    }
  </div>
</section>
