---
/**
 * Configuratore-calcolatore dentro la card scura del design.
 * Passi: intervento, materiale (dinamico per servizio), edificio,
 * superficie, urgenza, luogo, contatti. Mentre l'utente sceglie, in fondo
 * alla card compare una stima indicativa calcolata dal listino in
 * src/config/calcolatore.ts; la stessa stima parte nell'email insieme a
 * tutte le risposte. Chi sceglie "Non lo so, vorrei un sopralluogo" salta
 * il materiale e non riceve nessuna cifra.
 */
import { quizSteps, quoteSection } from '../config/content'
import { site, waLink } from '../config/site'
import {
  servizi,
  fasceSuperficie,
  fattoriEdificio,
  fattorePiccolaSuperficie,
  sogliaSopralluogoObbligatorio,
  disclaimerStima,
} from '../config/calcolatore'
import Icona from './Icona.astro'

// intervento + materiale + (edificio, superficie, urgenza) + luogo + contatti.
// Il totale mostrato all'utente e ricalcolato dallo script quando il passo
// materiale viene saltato.
const totaleStep = quizSteps.length + 3

// Il listino viaggia nel DOM come JSON: lo script resta un modulo esterno
// senza define:vars e la pagina non cambia peso percepito.
// `<` va sfuggito: un solo "</script" dentro un'etichetta futura del listino
// spezzerebbe il blocco JSON e con lui tutto il configuratore.
const datiCalcolatore = JSON.stringify({
  servizi,
  fasceSuperficie,
  fattoriEdificio,
  fattorePiccolaSuperficie,
  sogliaSopralluogoObbligatorio,
}).replace(/</g, '\\u003c')
---

<section id="preventivo" class="scroll-mt-24 bg-sabbia py-16 md:py-[120px]">
  <div class="contenitore grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,540px)] lg:gap-16">
    <!-- Colonna introduttiva -->
    <div class="rivela flex flex-col gap-6">
      <p class="occhiello">{quoteSection.eyebrow}</p>
      <h2 class="titolo-sezione max-w-[660px]">{quoteSection.title}</h2>
      <p class="max-w-[560px] font-sans leading-relaxed text-nero/80">{quoteSection.intro}</p>

      <div class="mt-2 flex max-w-[480px] items-center gap-5 rounded-md bg-crema p-6">
        <Icona nome="quote-form-phone" class="size-6 shrink-0 text-nero" />
        <div class="flex flex-col gap-1">
          <p class="font-sans text-sm text-taupe">{quoteSection.phoneQuestion}</p>
          <a href={`tel:${site.phoneHref}`} class="font-sans text-lg font-bold text-nero transition-colors hover:text-taupe">
            {quoteSection.phoneLabel} {site.phone}
          </a>
        </div>
      </div>
    </div>

    <!-- Card scura del configuratore -->
    <div class="rivela">
      <div
        id="quiz"
        class="relative overflow-hidden rounded-xl bg-nero p-6 text-white shadow-[0_16px_16px_rgba(0,0,0,0.25)] sm:p-12"
        data-whatsapp={site.whatsapp}
        data-telefono={site.phone}
        data-telefono-href={site.phoneHref}
        data-totale={totaleStep}
      >
        <!-- Intestazione + avanzamento -->
        <div id="quiz-avanzamento" class="flex flex-col gap-4">
          <div class="flex items-baseline justify-between gap-4">
            <p class="font-sans text-xs font-bold uppercase tracking-[0.1em] text-white">
              {quoteSection.cardLabel}
            </p>
            <p class="font-sans text-xs font-semibold text-sabbia/80">
              Fase <span id="quiz-numero">1</span> di <span id="quiz-totale">{totaleStep}</span>
            </p>
          </div>
          <div
            class="h-[3px] w-full overflow-hidden rounded-full bg-white/13"
            role="progressbar"
            aria-label="Avanzamento del preventivo"
            aria-valuemin="0"
            aria-valuemax={totaleStep}
            aria-valuenow="1"
            id="quiz-barra-contenitore"
          >
            <div id="quiz-barra" class="h-full bg-sabbia transition-[width] duration-500 ease-out" style="width: 14.3%"></div>
          </div>
        </div>

        <form id="quiz-form" method="post" novalidate class="mt-8">
          <!-- Passo 1: intervento -->
          {
            [quizSteps[0]].map((passo) => (
              <fieldset class="quiz-passo" data-passo={0} hidden>
                <legend class="font-display text-[1.75rem] font-normal leading-snug text-white">{passo.question}</legend>

                <div class="mt-6 grid gap-2.5">
                  {passo.options.map((opzione) => (
                    <label class="quiz-opzione group flex cursor-pointer items-center gap-3.5 rounded-[6px] border border-white/8 bg-nero-2 px-5 py-4 text-left font-sans text-[15px] font-medium text-white transition-all hover:border-white/30">
                      <input type="radio" class="quiz-scelta sr-only" name={passo.key} value={opzione.label} />
                      {opzione.icon && <Icona nome={`quote-form-${opzione.icon}`} class="size-5 shrink-0" />}
                      <span class="flex-1">{opzione.label}</span>
                      <span class="quiz-radio flex size-[18px] shrink-0 items-center justify-center rounded-full border-2 border-white/60" aria-hidden="true">
                        <span class="hidden size-2 rounded-full bg-nero" />
                      </span>
                    </label>
                  ))}
                </div>

                <div class="mt-7 flex gap-3">
                  <button type="button" class="quiz-indietro btn btn-contorno-scuro flex-1" disabled>
                    Indietro
                  </button>
                  <button type="button" class="quiz-avanti btn btn-bianco flex-1 !shadow-none" disabled>
                    Avanti
                  </button>
                </div>
              </fieldset>
            ))
          }

          <!-- Passo 2: materiale/dettaglio, opzioni riempite dallo script in base al servizio -->
          <fieldset class="quiz-passo" data-passo={1} hidden>
            <legend id="quiz-materiale-domanda" class="font-display text-[1.75rem] font-normal leading-snug text-white">
              Che tipo di materiale preferisci?
            </legend>

            <div id="quiz-materiale-opzioni" class="mt-6 grid gap-2.5"></div>

            <template id="quiz-materiale-riga">
              <label class="quiz-opzione group flex cursor-pointer items-center gap-3.5 rounded-[6px] border border-white/8 bg-nero-2 px-5 py-4 text-left font-sans text-[15px] font-medium text-white transition-all hover:border-white/30">
                <input type="radio" class="quiz-scelta sr-only" name="materiale" value="" />
                <span class="flex-1">
                  <span class="quiz-mat-label block"></span>
                  <span class="quiz-mat-hint mt-0.5 hidden text-[12.5px] font-normal leading-snug opacity-65"></span>
                </span>
                <span class="quiz-radio flex size-[18px] shrink-0 items-center justify-center rounded-full border-2 border-white/60" aria-hidden="true">
                  <span class="hidden size-2 rounded-full bg-nero"></span>
                </span>
              </label>
            </template>

            <div class="mt-7 flex gap-3">
              <button type="button" class="quiz-indietro btn btn-contorno-scuro flex-1">Indietro</button>
              <button type="button" class="quiz-avanti btn btn-bianco flex-1 !shadow-none" disabled>Avanti</button>
            </div>
          </fieldset>

          <!-- Passi 3-5: edificio, superficie, urgenza -->
          {
            quizSteps.slice(1).map((passo, i) => (
              <fieldset class="quiz-passo" data-passo={i + 2} hidden>
                <legend class="font-display text-[1.75rem] font-normal leading-snug text-white">{passo.question}</legend>

                <div class="mt-6 grid gap-2.5">
                  {passo.options.map((opzione) => (
                    <label class="quiz-opzione group flex cursor-pointer items-center gap-3.5 rounded-[6px] border border-white/8 bg-nero-2 px-5 py-4 text-left font-sans text-[15px] font-medium text-white transition-all hover:border-white/30">
                      <input type="radio" class="quiz-scelta sr-only" name={passo.key} value={opzione.label} />
                      {opzione.icon && <Icona nome={`quote-form-${opzione.icon}`} class="size-5 shrink-0" />}
                      <span class="flex-1">{opzione.label}</span>
                      <span class="quiz-radio flex size-[18px] shrink-0 items-center justify-center rounded-full border-2 border-white/60" aria-hidden="true">
                        <span class="hidden size-2 rounded-full bg-nero" />
                      </span>
                    </label>
                  ))}
                </div>

                {passo.key === 'superficie' && (
                  <div class="mt-4">
                    <label for="q-mq" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                      Metri quadri esatti, se li conosci <span class="font-normal normal-case tracking-normal text-sabbia/50">(facoltativo)</span>
                    </label>
                    <input
                      id="q-mq"
                      name="mq_esatti"
                      type="number"
                      inputmode="numeric"
                      min="10"
                      max="2000"
                      step="5"
                      placeholder="Es. 140"
                      class="campo"
                      aria-describedby="quiz-mq-avviso"
                    />
                    <p id="quiz-mq-avviso" hidden class="mt-2 font-sans text-[12.5px] leading-snug text-sabbia/70"></p>
                  </div>
                )}

                <div class="mt-7 flex gap-3">
                  <button type="button" class="quiz-indietro btn btn-contorno-scuro flex-1">Indietro</button>
                  <button type="button" class="quiz-avanti btn btn-bianco flex-1 !shadow-none" disabled>
                    Avanti
                  </button>
                </div>
              </fieldset>
            ))
          }

          <!-- Passo luogo -->
          <fieldset class="quiz-passo" data-passo={quizSteps.length + 1} hidden>
            <legend class="font-display text-[1.75rem] font-normal leading-snug text-white">Dove si trova l’immobile?</legend>
            <p class="mt-2 font-sans text-sm text-sabbia/70">Serve a capire se rientra nella nostra zona di intervento.</p>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <div>
                <label for="q-comune" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                  Comune
                </label>
                <input
                  id="q-comune"
                  name="comune"
                  type="text"
                  autocomplete="address-level2"
                  placeholder={site.city}
                  class="campo"
                  aria-describedby="quiz-errore"
                  required
                />
              </div>
              <div>
                <label for="q-cap" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                  CAP <span class="font-normal normal-case tracking-normal text-sabbia/50">(facoltativo)</span>
                </label>
                <input
                  id="q-cap"
                  name="cap"
                  type="text"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  maxlength="5"
                  placeholder={site.postalCode}
                  class="campo"
                />
              </div>
            </div>

            <div class="mt-7 flex gap-3">
              <button type="button" class="quiz-indietro btn btn-contorno-scuro flex-1">Indietro</button>
              <button type="button" class="quiz-avanti-luogo btn btn-bianco flex-1 !shadow-none">Avanti</button>
            </div>
          </fieldset>

          <!-- Passo contatti -->
          <fieldset class="quiz-passo" data-passo={quizSteps.length + 2} hidden>
            <legend class="font-display text-[1.75rem] font-normal leading-snug text-white">Come ti ricontattiamo?</legend>
            <p class="mt-2 font-sans text-sm text-sabbia/70">
              Ti chiamiamo entro {site.responseHours} ore. Niente call center, niente messaggi automatici.
            </p>

            <div class="mt-6 grid gap-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="q-nome" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                    Nome e cognome
                  </label>
                  <input id="q-nome" name="nome" type="text" autocomplete="name" class="campo" aria-describedby="quiz-errore" required />
                </div>
                <div>
                  <label for="q-telefono" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                    Telefono
                  </label>
                  <input
                    id="q-telefono"
                    name="telefono"
                    type="tel"
                    autocomplete="tel"
                    inputmode="tel"
                    class="campo"
                    aria-describedby="quiz-errore"
                    required
                  />
                </div>
              </div>

              <div>
                <label for="q-email" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                  Email <span class="font-normal normal-case tracking-normal text-sabbia/50">(facoltativa)</span>
                </label>
                <input id="q-email" name="email" type="email" autocomplete="email" class="campo" />
              </div>

              <div>
                <label for="q-note" class="mb-2 block font-sans text-xs font-bold uppercase tracking-[0.08em] text-sabbia/80">
                  Vuoi aggiungere qualcosa? <span class="font-normal normal-case tracking-normal text-sabbia/50">(facoltativo)</span>
                </label>
                <textarea id="q-note" name="note" rows="3" class="campo resize-y" placeholder="Es. perde acqua sopra la camera da letto quando piove forte"
                ></textarea>
              </div>

              <label class="flex items-start gap-3 font-sans text-[13px] leading-relaxed text-sabbia/80">
                <input id="q-privacy" name="privacy" type="checkbox" aria-describedby="quiz-errore" required class="mt-0.5 size-4 shrink-0 accent-[#EAE5DA]" />
                <span>
                  Ho preso visione dell'<a href="/privacy/" class="font-semibold text-sabbia underline underline-offset-2">informativa privacy</a>.
                </span>
              </label>

              <!-- Trappola anti-spam, invisibile agli utenti. Il nome `botcheck` e
                   controllato anche lato server da api/richiesta.ts. -->
              <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px] size-0 opacity-0" />

              <div class="mt-1 flex gap-3">
                <button type="button" class="quiz-indietro btn btn-contorno-scuro">Indietro</button>
                <button type="submit" id="quiz-invia" class="btn btn-bianco flex-1 !shadow-none">
                  <span class="quiz-invia-testo">Invia la richiesta</span>
                  <svg class="quiz-spinner hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25" />
                    <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  </svg>
                </button>
              </div>

              <p class="text-center font-sans text-[11px] leading-relaxed text-sabbia/50">
                Vi richiamiamo per fissare il sopralluogo gratuito: il preventivo nasce da lì, non da
                questo modulo. I dati servono solo a rispondervi e non vengono ceduti a nessuno.
              </p>
            </div>
          </fieldset>

          <!-- Fuori dai fieldset: cosi il messaggio resta visibile in qualsiasi passo -->
          <p
            id="quiz-errore"
            tabindex="-1"
            class="mt-4 hidden rounded-[4px] border-l-2 border-red-400 bg-red-950/40 px-4 py-3 font-sans text-sm text-red-200"
            role="alert"
          >
          </p>
        </form>

        <!-- Stima indicativa: compare appena servizio e dettaglio sono scelti
             e si aggiorna a ogni risposta. aria-live per gli screen reader. -->
        <div id="quiz-stima" hidden class="mt-7 rounded-[8px] border border-sabbia/25 bg-nero-2 px-5 py-4" aria-live="polite">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="font-sans text-[11px] font-bold uppercase tracking-[0.1em] text-sabbia/70">Stima indicativa</p>
            <p class="font-sans text-[11px] text-sabbia/50">IVA esclusa</p>
          </div>
          <p class="mt-1.5 font-display text-[1.9rem] font-normal leading-none text-white">
            <span id="quiz-stima-valore">&nbsp;</span>
          </p>
          <p id="quiz-stima-unita" class="mt-1 font-sans text-xs text-sabbia/60"></p>
        </div>

        <script id="quiz-dati" type="application/json" set:html={datiCalcolatore} />

        <!-- Senza JavaScript la card resterebbe vuota: i fieldset nascono
             tutti hidden. Qui restano i contatti diretti, che sono l'unica
             cosa che questa sezione non puo permettersi di perdere. -->
        <noscript>
          <div class="rounded-[8px] border border-sabbia/25 bg-nero-2 px-5 py-5">
            <p class="font-sans text-sm leading-relaxed text-sabbia/85">
              Il configuratore richiede JavaScript. Chiamateci o scriveteci: rispondiamo entro {site.responseHours} ore.
            </p>
            <a href={`tel:${site.phoneHref}`} class="btn btn-bianco mt-4 w-full !py-4">Chiama {site.phone}</a>
            <a href={waLink()} target="_blank" rel="noopener" class="btn mt-3 w-full bg-whatsapp !py-4 text-white">
              Scrivici su WhatsApp
            </a>
            <a
              href={`mailto:${site.email}`}
              class="mt-4 block text-center font-sans text-sm font-bold text-sabbia underline-offset-4 hover:underline"
            >
              {site.email}
            </a>
          </div>
        </noscript>

        <!-- Conferma -->
        <div id="quiz-fatto" hidden role="status" class="py-4 text-center">
          <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-sabbia">
            <svg class="size-8 text-nero" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="m4 12.5 5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>

          <h3 id="quiz-fatto-titolo" tabindex="-1" class="mt-6 font-display text-3xl font-normal">Richiesta ricevuta</h3>

          <!-- Riepilogo della stima, mostrato solo quando una stima esiste -->
          <div id="quiz-fatto-stima" hidden class="mx-auto mt-6 max-w-md rounded-[8px] border border-sabbia/25 bg-nero-2 px-6 py-5">
            <p class="font-sans text-[11px] font-bold uppercase tracking-[0.1em] text-sabbia/70">La tua stima indicativa</p>
            <p class="mt-2 font-display text-4xl font-normal leading-none text-white">
              <span id="quiz-fatto-stima-valore"></span>
            </p>
            <p class="mt-3 font-sans text-xs leading-relaxed text-sabbia/60">{disclaimerStima}</p>
          </div>

          <p class="mx-auto mt-3 max-w-md font-sans text-[15px] leading-relaxed text-sabbia/80">
            Grazie. Abbiamo tutto quello che ci serve per una prima valutazione e ti ricontattiamo entro
            {site.responseHours} ore per fissare il sopralluogo gratuito.
          </p>

          <div class="mx-auto mt-8 max-w-sm border-t border-white/10 pt-8">
            <p class="font-sans text-sm text-sabbia/70">Vuoi una risposta ancora più rapida?</p>
            <a id="quiz-whatsapp" href="#" target="_blank" rel="noopener" class="btn mt-3 w-full bg-whatsapp !py-4 text-white hover:opacity-90">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41a9.36 9.36 0 0 1 9.41 9.42c0 5.19-4.23 9.41-9.42 9.41ZM20.52 3.49A11.78 11.78 0 0 0 12.05 0C5.5 0 .18 5.32.17 11.86c0 2.09.55 4.13 1.59 5.93L.07 24l6.36-1.67a11.9 11.9 0 0 0 5.62 1.43h.01c6.54 0 11.86-5.32 11.87-11.86a11.8 11.8 0 0 0-3.41-8.41Z"></path>
              </svg>
              Mandaci la richiesta su WhatsApp
            </a>
            <a href={`tel:${site.phoneHref}`} class="mt-3 block font-sans text-sm font-bold text-sabbia underline-offset-4 hover:underline">
              Oppure chiamaci allo {site.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .campo {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background-color: var(--color-nero-2);
    padding: 0.85rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: #fff;
    border-radius: 6px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .campo::placeholder {
    color: rgba(234, 229, 218, 0.4);
  }

  .campo:focus {
    border-color: var(--color-sabbia);
    box-shadow: 0 0 0 3px rgba(234, 229, 218, 0.15);
  }

  .campo[aria-invalid='true'] {
    border-color: #f87171;
  }

  /* Opzione selezionata: chiara su scuro, come nel design.
     Il radio nativo e visivamente nascosto, l'aspetto lo guida :checked. */
  .quiz-opzione:has(.quiz-scelta:checked) {
    background-color: var(--color-sabbia);
    border-color: var(--color-sabbia);
    color: var(--color-nero);
    font-weight: 700;
  }

  .quiz-opzione:has(.quiz-scelta:checked) .quiz-radio {
    border-color: var(--color-nero);
    background-color: var(--color-nero);
  }

  .quiz-opzione:has(.quiz-scelta:checked) .quiz-radio > span {
    display: block;
    background-color: var(--color-sabbia);
  }

  /* Il focus da tastiera si vede sull'etichetta, non sul radio nascosto */
  .quiz-opzione:has(.quiz-scelta:focus-visible) {
    outline: 2px solid var(--color-sabbia);
    outline-offset: 3px;
  }

  .btn:disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  /* La stima entra dal basso la prima volta che compare */
  @keyframes quiz-stima-su {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .quiz-stima-entra {
    animation: quiz-stima-su 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-stima-entra {
      animation: none;
    }
  }
</style>

<!-- I coriandoli nascono da JavaScript, quindi non ricevono l'attributo di
     scope di Astro: le loro regole devono restare globali, altrimenti non si
     applicano mai. Restano comunque circoscritte alla classe .quiz-coriandoli. -->
<style is:global>
  .quiz-coriandoli {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
  }

  .quiz-coriandoli span {
    position: absolute;
    top: -14px;
    width: 8px;
    height: 12px;
    opacity: 0;
    animation-name: quiz-cade;
    animation-timing-function: cubic-bezier(0.25, 0.6, 0.4, 1);
    animation-fill-mode: forwards;
  }

  @keyframes quiz-cade {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    12% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--deriva), 460px, 0) rotate(var(--giro));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-coriandoli span {
      animation: none;
    }
  }
</style>

<script>
  import { inviaRichiesta } from '../lib/richieste'

  const quiz = document.getElementById('quiz')
  if (quiz) {
    // Valori di configurazione letti dagli attributi data: senza define:vars
    // lo script resta un modulo differito e non blocca il parser.
    const WHATSAPP = quiz.dataset.whatsapp
    /** La funzione server che manda l'email con Resend. Vedi api/richiesta.ts. */
    const ENDPOINT = '/api/richiesta'
    const TELEFONO = quiz.dataset.telefono
    const TELEFONO_HREF = quiz.dataset.telefonoHref

    // Listino e fattori del calcolatore, serializzati dal build. Se il JSON
    // fosse illeggibile spariscono solo le cifre: il configuratore continua a
    // raccogliere il contatto, che e la cosa che non si puo perdere.
    const VUOTO = { servizi: [], fasceSuperficie: {}, fattoriEdificio: {}, fattorePiccolaSuperficie: { sogliaMq: 0, min: 1, max: 1 }, sogliaSopralluogoObbligatorio: Infinity }
    let DATI = VUOTO
    try {
      DATI = JSON.parse(document.getElementById('quiz-dati').textContent)
    } catch (err) {
      console.error('Listino del calcolatore non leggibile, stima disattivata:', err)
    }
    const SOPRALLUOGO = 'Non lo so, vorrei un sopralluogo'
    const SUP_NON_SO = 'Non lo so'


    const form = document.getElementById('quiz-form')
    const passi = [...quiz.querySelectorAll('.quiz-passo')]
    const barra = document.getElementById('quiz-barra')
    const numero = document.getElementById('quiz-numero')
    const avanzamento = document.getElementById('quiz-avanzamento')
    const barraAria = document.getElementById('quiz-barra-contenitore')
    const fatto = document.getElementById('quiz-fatto')
    const errore = document.getElementById('quiz-errore')
    const invia = document.getElementById('quiz-invia')

    const risposte = {}
    let corrente = 0

    const traccia = (nome, dati = {}) => {
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({ event: nome, ...dati })
      if (typeof window.gtag === 'function') window.gtag('event', nome, dati)
    }

    const nascondiErrore = () => {
      errore.classList.add('hidden')
      errore.textContent = ''
    }

    // Prima si mostra il contenitore, poi si scrive il testo: cosi
    // l'elemento e gia nell'albero di accessibilita.
    const mostraErrore = (testo) => {
      errore.classList.remove('hidden')
      errore.textContent = testo
    }

    /* --- PASSI ATTIVI ------------------------------------------------------
       Il passo materiale (indice 1) esiste solo per i servizi a listino: chi
       sceglie il sopralluogo lo salta e non vede nessuna cifra. La numerazione
       mostrata all'utente segue i passi attivi, non gli indici del DOM. */
    const PASSO_MATERIALE = 1
    const indici = passi.map((p) => Number(p.dataset.passo))
    let attivi = indici.slice()

    // Unica fonte di verita: il passo si cerca per data-passo, mai per
    // posizione nell'array, cosi riordinare il markup non rompe niente.
    const passoCon = (i) => passi.find((p) => Number(p.dataset.passo) === i)

    const servizioScelto = () => DATI.servizi.find((s) => s.intervento === risposte.intervento)

    // Finche l'intervento non e stato scelto il passo materiale resta contato:
    // altrimenti all'avvio il totale scenderebbe da 7 a 6 per poi risalire a 7
    // alla prima scelta, e il contatore ballerebbe sotto gli occhi del visitatore.
    const ricalcolaAttivi = () => {
      const salta = Boolean(risposte.intervento) && !servizioScelto()
      attivi = indici.filter((i) => !(salta && i === PASSO_MATERIALE))
    }

    /* --- CALCOLO DELLA STIMA ---------------------------------------------- */
    const stimaBox = document.getElementById('quiz-stima')
    const stimaValore = document.getElementById('quiz-stima-valore')
    const stimaUnita = document.getElementById('quiz-stima-unita')
    // it-IT di default non raggruppa i numeri di quattro cifre: "7500" accanto
    // a "14.500" sembra un errore di battitura. Qui il punto c'e sempre.
    const nf = { format: (n) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.') }
    const pigro = matchMedia('(prefers-reduced-motion: reduce)')

    const mqEsatti = () => {
      const v = Number(document.getElementById('q-mq')?.value)
      return Number.isFinite(v) && v >= 10 && v <= 2000 ? v : 0
    }

    // Scaglioni leggibili: nessuna cifra finta-precisa tipo "12.437 euro" in
    // una stima indicativa. Il minimo scende e il massimo sale, cosi
    // l'arrotondamento allarga la forbice invece di stringerla.
    const scaglione = (n) => (n >= 5000 ? 500 : n >= 1000 ? 100 : n >= 300 ? 50 : 10)
    const giuAl = (n) => Math.floor(n / scaglione(n)) * scaglione(n)
    const suAl = (n) => Math.ceil(n / scaglione(n)) * scaglione(n)

    // Sviluppo delle lattonerie ricavato dai mq: perimetro di una falda
    // all'incirca quadrata piu le discese. Unica formula, usata sia con la
    // fascia sia coi metri esatti, altrimenti lo stesso tetto darebbe due
    // risposte diverse. E una stima di limite superiore, non una media.
    const metriLineari = (mq) => Math.round(4 * Math.sqrt(mq) + 12)

    const calcolaStima = () => {
      const servizio = servizioScelto()
      if (!servizio) return null

      const voce = servizio.voci.find((v) => v.id === risposte.materiale)
      if (!voce) return null

      let min = voce.min
      let max = voce.max
      let mqUsati = 0
      let daMetriEsatti = false

      if (voce.unita !== 'euro_forfait') {
        const esatti = mqEsatti()
        const fascia = DATI.fasceSuperficie[risposte.superficie]
        const mq = esatti || fascia?.mq
        if (!mq) return null

        // Sopra la soglia sono cantieri industriali: il listino residenziale
        // non si estrapola, si passa direttamente al sopralluogo.
        if (mq > DATI.sogliaSopralluogoObbligatorio) return { troppoGrande: true }

        mqUsati = mq
        daMetriEsatti = Boolean(esatti)

        const quantita = voce.unita === 'euro_ml' ? metriLineari(mq) : mq
        min *= quantita
        max *= quantita

        // Maggiorazione graduale, non a scalino: a 60 mq vale zero, sotto
        // cresce in proporzione. Senza questo, 59 mq costava piu di 60.
        const piccola = DATI.fattorePiccolaSuperficie
        if (mq < piccola.sogliaMq) {
          const peso = (piccola.sogliaMq - mq) / piccola.sogliaMq
          min *= 1 + (piccola.min - 1) * peso
          max *= 1 + (piccola.max - 1) * peso
        }
      }

      const fattore = DATI.fattoriEdificio[risposte.edificio]
      if (fattore) {
        min *= fattore.min
        max *= fattore.max
      }

      return { min: giuAl(min), max: suAl(max), unita: voce.unita, mqUsati, daMetriEsatti }
    }

    // Conteggio progressivo: la cifra sale invece di apparire di colpo.
    let animazione = 0
    const scriviStima = (elemento, min, max, animata) => {
      const stampa = (a, b) => (elemento.textContent = `da ${nf.format(a)} a ${nf.format(b)} €`)
      cancelAnimationFrame(animazione)

      // Il valore finale si scrive SEMPRE per primo: in una scheda in secondo
      // piano requestAnimationFrame non parte, e senza questa riga la cifra
      // resterebbe vuota fino al ritorno dell'utente.
      stampa(min, max)

      if (!animata || pigro.matches) return

      const durata = 550
      const avvio = performance.now()
      const passo = (ora) => {
        const t = Math.min((ora - avvio) / durata, 1)
        const morbido = 1 - Math.pow(1 - t, 3)
        stampa(Math.round((min * morbido) / 10) * 10, Math.round((max * morbido) / 10) * 10)
        if (t < 1) animazione = requestAnimationFrame(passo)
        else stampa(min, max)
      }
      animazione = requestAnimationFrame(passo)
    }

    let ultimaStima = null

    const aggiornaStima = (animata = true) => {
      const s = calcolaStima()

      // Nessuna stima possibile: si nasconde tutto.
      if (!s) {
        ultimaStima = null
        stimaBox.hidden = true
        return
      }

      // Superficie fuori scala: si dice perche, senza inventare una cifra.
      if (s.troppoGrande) {
        ultimaStima = null
        stimaBox.hidden = false
        stimaValore.textContent = 'Solo con sopralluogo'
        stimaUnita.textContent =
          'Su superfici di queste dimensioni una stima automatica non sarebbe seria: veniamo a misurare e vi diamo un computo metrico vero.'
        return
      }

      // Si rianima solo se la cifra e davvero cambiata: rispondere a una
      // domanda che non entra nel calcolo non deve far ripartire il conteggio.
      const cambiata = !ultimaStima || ultimaStima.min !== s.min || ultimaStima.max !== s.max
      const apparsa = stimaBox.hidden
      ultimaStima = s

      stimaBox.hidden = false
      if (apparsa && !pigro.matches) {
        stimaBox.classList.remove('quiz-stima-entra')
        void stimaBox.offsetWidth
        stimaBox.classList.add('quiz-stima-entra')
      }

      scriviStima(stimaValore, s.min, s.max, animata && cambiata)

      const base =
        s.unita === 'euro_forfait'
          ? 'Intervento a corpo, si aggiorna a ogni risposta.'
          : s.daMetriEsatti
            ? `Calcolata sui ${s.mqUsati} mq che hai indicato. Si aggiorna a ogni risposta.`
            : 'Valore orientativo per l’intera copertura, si aggiorna a ogni risposta.'
      stimaUnita.textContent = `${base} Stima non vincolante su parametri medi di mercato: il prezzo si definisce dopo il sopralluogo gratuito.`
    }

    /* --- PASSO MATERIALE, COSTRUITO AL VOLO -------------------------------- */
    const materialeDomanda = document.getElementById('quiz-materiale-domanda')
    const materialeOpzioni = document.getElementById('quiz-materiale-opzioni')
    const modelloRiga = document.getElementById('quiz-materiale-riga')

    const costruisciMateriale = () => {
      // La pulizia va fatta SEMPRE, anche quando il servizio scelto non ha
      // listino: altrimenti chi torna indietro e passa al sopralluogo lascia
      // in memoria il materiale di prima e se lo ritrova nell'email.
      materialeOpzioni.replaceChildren()
      delete risposte.materiale
      delete risposte.materialeLabel
      passoCon(PASSO_MATERIALE).querySelector('.quiz-avanti').disabled = true

      const servizio = servizioScelto()
      if (!servizio) return

      materialeDomanda.textContent = servizio.domanda

      servizio.voci.forEach((voce) => {
        const riga = modelloRiga.content.cloneNode(true)
        const input = riga.querySelector('input')
        input.value = voce.id
        riga.querySelector('.quiz-mat-label').textContent = voce.label
        const hint = riga.querySelector('.quiz-mat-hint')
        if (voce.hint) {
          hint.textContent = voce.hint
          hint.classList.remove('hidden')
        }
        input.addEventListener('change', () => {
          if (!input.checked) return
          risposte.materiale = voce.id
          risposte.materialeLabel = voce.label
          passoCon(PASSO_MATERIALE).querySelector('.quiz-avanti').disabled = false
          aggiornaStima()
        })
        materialeOpzioni.append(riga)
      })
    }

    // `focalizza` resta falso all'avvio: il configuratore non deve rubare
    // il focus al caricamento della pagina (skip link e header restano
    // raggiungibili con Tab).
    const mostraPasso = (indice, scorri = true, focalizza = true) => {
      corrente = indice
      nascondiErrore()
      passi.forEach((p) => (p.hidden = Number(p.dataset.passo) !== indice))

      const posizione = attivi.indexOf(indice) + 1
      const totale = attivi.length
      barra.style.width = `${(posizione / totale) * 100}%`
      numero.textContent = String(posizione)
      barraAria.setAttribute('aria-valuenow', String(posizione))
      barraAria.setAttribute('aria-valuemax', String(totale))
      document.getElementById('quiz-totale').textContent = String(totale)

      const legenda = passoCon(indice).querySelector('legend')
      if (focalizza && legenda) {
        legenda.setAttribute('tabindex', '-1')
        legenda.focus({ preventScroll: true })
      }

      if (scorri && window.scrollY > quiz.offsetTop - 140) {
        quiz.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }

      traccia('preventivo_passo', { passo: posizione, totale })
    }

    const vaiAvanti = () => {
      const i = attivi.indexOf(corrente)
      mostraPasso(attivi[Math.min(i + 1, attivi.length - 1)])
    }
    const vaiIndietro = () => {
      const i = attivi.indexOf(corrente)
      mostraPasso(attivi[Math.max(i - 1, 0)])
    }

    // Selezione di un'opzione: sono radio nativi, la deselezione degli altri
    // la fa il browser. Qui restano solo memoria della risposta e Avanti.
    quiz.querySelectorAll('.quiz-scelta').forEach((scelta) => {
      scelta.addEventListener('change', () => {
        if (!scelta.checked) return
        risposte[scelta.name] = scelta.value

        const fieldset = scelta.closest('.quiz-passo')
        const avanti = fieldset.querySelector('.quiz-avanti')
        if (avanti) avanti.disabled = false

        if (scelta.name === 'intervento') {
          ricalcolaAttivi()
          costruisciMateriale()
          // Il totale cambia subito, non al click successivo: chi passa al
          // sopralluogo deve vedere "di 6" mentre e ancora sul passo 1.
          mostraPasso(corrente, false, false)
        }
        aggiornaStima()
      })
    })

    // Metri quadri esatti: aggiornano la stima mentre si digita e da soli
    // bastano ad andare avanti. Chi da il dato piu preciso non deve restare
    // bloccato per non aver bifato anche una fascia.
    const campoMq = document.getElementById('q-mq')
    const avvisoMq = document.getElementById('quiz-mq-avviso')
    const PASSO_SUPERFICIE = 3
    const fasciaBifata = () => Boolean(quiz.querySelector('input[name="superficie"]:checked'))

    campoMq?.addEventListener('input', () => {
      const grezzo = campoMq.value.trim()
      const numero = Number(grezzo)
      const valido = mqEsatti() > 0
      const fuoriScala = grezzo !== '' && !valido

      avvisoMq.hidden = !fuoriScala
      if (fuoriScala) {
        avvisoMq.textContent =
          Number.isFinite(numero) && numero > 0
            ? 'Indica un valore fra 10 e 2000 mq, oppure scegli una fascia qui sopra.'
            : 'Scrivi solo il numero dei metri quadri, oppure scegli una fascia qui sopra.'
      }

      // Prima si aggiorna la risposta, poi si decide il pulsante: al contrario
      // si giudicherebbe sul valore vecchio e Avanti resterebbe attivo a vuoto.
      if (valido && !fasciaBifata()) risposte.superficie = `${mqEsatti()} mq indicati`
      else if (!valido && risposte.superficie?.endsWith('mq indicati')) delete risposte.superficie

      const avanti = passoCon(PASSO_SUPERFICIE)?.querySelector('.quiz-avanti')
      if (avanti) avanti.disabled = !valido && !fasciaBifata()

      aggiornaStima(false)
    })

    // Avanti nei passi a scelta
    quiz.querySelectorAll('.quiz-avanti').forEach((pulsante) => {
      pulsante.addEventListener('click', vaiAvanti)
    })

    // Avanti nel passo luogo: richiede il comune
    quiz.querySelectorAll('.quiz-avanti-luogo').forEach((pulsante) => {
      pulsante.addEventListener('click', () => {
        const comune = document.getElementById('q-comune')
        if (!comune.value.trim()) {
          mostraErrore("Indica il comune dove si trova l’immobile.")
          comune.setAttribute('aria-invalid', 'true')
          comune.focus()
          return
        }
        comune.removeAttribute('aria-invalid')
        nascondiErrore()
        vaiAvanti()
      })
    })

    // Indietro, presente in ogni passo
    quiz.querySelectorAll('.quiz-indietro').forEach((pulsante) => {
      pulsante.addEventListener('click', vaiIndietro)
    })

    // Invio da tastiera nel passo luogo: vale sia nel campo obbligatorio
    // Comune sia in quello facoltativo CAP.
    ;['q-comune', 'q-cap'].forEach((id) => {
      document.getElementById(id)?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault()
          quiz.querySelector('.quiz-avanti-luogo')?.click()
        }
      })
    })

    const testoStima = () =>
      ultimaStima ? `da ${nf.format(ultimaStima.min)} a ${nf.format(ultimaStima.max)} € (IVA esclusa)` : null

    const riepilogo = (dati) =>
      [
        `Intervento: ${risposte.intervento || 'non indicato'}`,
        risposte.materialeLabel ? `Materiale / dettaglio: ${risposte.materialeLabel}` : null,
        `Edificio: ${risposte.edificio || 'non indicato'}`,
        `Superficie: ${risposte.superficie || 'non indicata'}${dati.mq_esatti ? ` (indicati ${dati.mq_esatti} mq)` : ''}`,
        `Tempistica: ${risposte.urgenza || 'non indicata'}`,
        '',
        `STIMA MOSTRATA AL CLIENTE: ${testoStima() || 'nessuna, ha chiesto direttamente il sopralluogo'}`,
        '',
        `Comune: ${dati.comune}${dati.cap ? ` (${dati.cap})` : ''}`,
        `Nome: ${dati.nome}`,
        `Telefono: ${dati.telefono}`,
        dati.email ? `Email: ${dati.email}` : null,
        dati.note ? `Note: ${dati.note}` : null,
      ]
        .filter((r) => r !== null)
        .join('\n')

    const ripristinaPulsante = () => {
      invia.disabled = false
      invia.querySelector('.quiz-invia-testo').textContent = 'Invia la richiesta'
      invia.querySelector('.quiz-spinner').classList.add('hidden')
    }

    const linkErrore = (href, etichetta, nuovaScheda = false) => {
      const a = document.createElement('a')
      a.href = href
      a.className = 'font-bold underline underline-offset-2'
      a.textContent = etichetta
      if (nuovaScheda) {
        a.target = '_blank'
        a.rel = 'noopener'
      }
      return a
    }

    // Invio fallito: il configuratore resta aperto, nessun evento di
    // conversione, e offriamo subito telefono e WhatsApp precompilato.
    const mostraErroreInvio = (testo) => {
      ripristinaPulsante()
      errore.classList.remove('hidden')
      errore.textContent = 'Non siamo riusciti a inviare la richiesta. Chiamaci allo '
      errore.append(
        linkErrore(`tel:${TELEFONO_HREF}`, TELEFONO),
        ' oppure scrivici su ',
        linkErrore(
          `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`Buongiorno, ho compilato il preventivo sul sito.\n\n${testo}`)}`,
          'WhatsApp',
          true,
        ),
        '.',
      )
      errore.focus()
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      nascondiErrore()

      const fd = new FormData(form)
      const dati = Object.fromEntries(fd.entries())

      if (dati.botcheck) return

      const nome = document.getElementById('q-nome')
      const telefono = document.getElementById('q-telefono')
      const campoVuoto = !dati.nome?.trim() ? nome : !dati.telefono?.trim() ? telefono : null

      if (campoVuoto) {
        mostraErrore('Inserisci il nome e un numero di telefono per poterti ricontattare.')
        nome.setAttribute('aria-invalid', String(!dati.nome?.trim()))
        telefono.setAttribute('aria-invalid', String(!dati.telefono?.trim()))
        campoVuoto.focus()
        return
      }
      nome.removeAttribute('aria-invalid')
      telefono.removeAttribute('aria-invalid')

      const privacy = document.getElementById('q-privacy')
      if (!privacy.checked) {
        mostraErrore("Per procedere serve la presa visione dell’informativa privacy.")
        privacy.setAttribute('aria-invalid', 'true')
        privacy.focus()
        return
      }
      privacy.removeAttribute('aria-invalid')

      const testo = riepilogo(dati)

      invia.disabled = true
      invia.querySelector('.quiz-invia-testo').textContent = 'Invio in corso'
      invia.querySelector('.quiz-spinner').classList.remove('hidden')

      // Coriandoli: cadono dall'alto della card, durano poco e si rimuovono
      // da soli. Niente libreria esterna, niente lavoro se l'utente ha
      // chiesto meno animazioni.
      const coriandoli = () => {
        if (pigro.matches) return
        const tinte = ['#EAE5DA', '#8E7E6A', '#F7F4EB', '#C9BCA6']
        const pista = document.createElement('div')
        pista.className = 'quiz-coriandoli'
        pista.setAttribute('aria-hidden', 'true')

        for (let i = 0; i < 34; i++) {
          const pezzo = document.createElement('span')
          pezzo.style.left = `${Math.random() * 100}%`
          pezzo.style.background = tinte[i % tinte.length]
          pezzo.style.animationDelay = `${Math.random() * 0.45}s`
          pezzo.style.animationDuration = `${1.5 + Math.random() * 1.1}s`
          pezzo.style.setProperty('--deriva', `${(Math.random() - 0.5) * 130}px`)
          pezzo.style.setProperty('--giro', `${Math.random() * 720 - 360}deg`)
          if (i % 3 === 0) pezzo.style.borderRadius = '50%'
          pista.append(pezzo)
        }

        quiz.append(pista)
        setTimeout(() => pista.remove(), 3200)
      }

      const concludi = () => {
        document.getElementById('quiz-whatsapp').href =
          `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`Buongiorno, ho compilato il preventivo sul sito.\n\n${testo}`)}`
        form.hidden = true
        avanzamento.hidden = true
        stimaBox.hidden = true
        fatto.hidden = false

        // La stima torna grande sulla schermata finale, se esiste.
        if (ultimaStima) {
          const riquadro = document.getElementById('quiz-fatto-stima')
          riquadro.hidden = false
          scriviStima(document.getElementById('quiz-fatto-stima-valore'), ultimaStima.min, ultimaStima.max, true)
        }

        document.getElementById('quiz-fatto-titolo').focus({ preventScroll: true })
        fatto.scrollIntoView({ behavior: 'smooth', block: 'center' })
        coriandoli()

        traccia('preventivo_inviato', {
          intervento: risposte.intervento,
          materiale: risposte.materiale,
          superficie: risposte.superficie,
          urgenza: risposte.urgenza,
          stima_min: ultimaStima?.min,
          stima_max: ultimaStima?.max,
        })
      }

      // La richiesta parte per due strade insieme: il database, dove il
      // cliente la ritrova nel pannello con tutte le risposte del
      // configuratore anche se l'email non arriva, e la nostra funzione
      // server per l'email. Basta che una delle due arrivi.
      const richiesta = {
        tipo: 'preventivo',
        nome: dati.nome,
        telefono: dati.telefono,
        email: dati.email || '',
        comune: dati.comune || '',
        cap: dati.cap || '',
        servizio: risposte.intervento || '',
        messaggio: dati.note || '',
        dettagli: {
          intervento: risposte.intervento || null,
          materiale: risposte.materialeLabel || null,
          edificio: risposte.edificio || null,
          superficie: risposte.superficie || null,
          mq_esatti: dati.mq_esatti || null,
          urgenza: risposte.urgenza || null,
          stima_min: ultimaStima ? ultimaStima.min : null,
          stima_max: ultimaStima ? ultimaStima.max : null,
          stima: testoStima() || null,
        },
        pagina: location.pathname,
        // Lo aggiunge inviaRichiesta, che sa se la persona è arrivata da un link.
        codice_link: null,
      }

      const viaEmail = async () => {
        const risposta = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            tipo: 'preventivo',
            nome: dati.nome,
            telefono: dati.telefono,
            email: dati.email || '',
            comune: dati.comune || '',
            cap: dati.cap || '',
            servizio: risposte.intervento || '',
            messaggio: dati.note || '',
            privacy: true,
            // Le stesse voci che finiscono nel pannello, cosi email e
            // database raccontano la stessa richiesta.
            dettagli: richiesta.dettagli,
            pagina: location.pathname,
          }),
        })
        if (!risposta.ok) {
          const dettaglio = await risposta.json().catch(() => null)
          throw new Error(`HTTP ${risposta.status}${dettaglio?.errore ? `: ${dettaglio.errore}` : ''}`)
        }
        return true
      }

      try {
        const [nelDatabase, perEmail] = await Promise.allSettled([inviaRichiesta(richiesta), viaEmail()])
        const salvata = nelDatabase.status === 'fulfilled' && nelDatabase.value === true
        const inviata = perEmail.status === 'fulfilled' && perEmail.value === true

        if (salvata || inviata) {
          concludi()
          return
        }

        const motivoEmail =
          perEmail.status === 'rejected' && perEmail.reason instanceof Error ? perEmail.reason.message : 'errore sconosciuto'
        throw new Error(`database non raggiungibile; email: ${motivoEmail}`)
      } catch (err) {
        // Né il database né l'email hanno preso la richiesta: NON mostriamo la
        // conferma e NON tracciamo una conversione che non è mai avvenuta.
        console.error('Invio preventivo non riuscito:', err)
        if (import.meta.env.DEV) {
          console.warn('[MDA] /api/richiesta non ha risposto. In locale la rotta c\u2019e, ma senza RESEND_API_KEY, RICHIESTE_A e RICHIESTE_DA in .env risponde 500.')
        }
        mostraErroreInvio(testo)
        traccia('preventivo_invio_fallito', { motivo: err instanceof Error ? err.message : 'errore sconosciuto' })
      }
    })

    ricalcolaAttivi()
    mostraPasso(0, false, false)
  }
</script>
