---
import { site } from '../config/site'
import Icona from './Icona.astro'
import Logo from './Logo.astro'

const nav = [
  { label: 'I Nostri Servizi', href: '/#servizi' },
  { label: 'Come Lavoriamo', href: '/#processo' },
  { label: 'Portfolio', href: '/#lavori' },
  { label: 'FAQ', href: '/#domande' },
]
---

<header
  id="testata"
  class="sticky top-0 z-50 border-b border-nero/8 bg-crema/95 backdrop-blur-md transition-shadow"
>
  <div class="contenitore flex h-[70px] items-center justify-between gap-4 lg:h-[90px]">
    <a href="/" aria-label={`${site.name}, torna in cima`} class="shrink-0">
      <Logo class="h-11 w-auto lg:h-[58px]" />
    </a>

    <nav aria-label="Navigazione principale" class="hidden items-center gap-10 lg:flex">
      {
        nav.map((voce) => (
          <a
            href={voce.href}
            class="relative py-1 font-sans text-sm font-semibold text-nero transition-colors hover:text-taupe after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-taupe after:transition-all after:duration-300 hover:after:w-full"
          >
            {voce.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-5">
      <a
        href={`tel:${site.phoneHref}`}
        class="hidden items-center gap-2.5 font-sans text-[15px] font-bold text-nero transition-colors hover:text-taupe xl:flex"
      >
        <Icona nome="header-phone-call" class="size-4 text-taupe" />
        {site.phone}
      </a>

      <a href="/#preventivo" class="btn btn-nero hidden sm:inline-flex">Preventivo Gratuito</a>

      <!-- Hamburger, solo mobile: quadrato scuro 36px come nel design -->
      <button
        type="button"
        id="apri-menu"
        aria-label="Apri il menu"
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="flex size-9 items-center justify-center rounded-[4px] bg-nero text-white lg:hidden"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="menu-mobile" hidden class="border-t border-nero/8 bg-crema lg:hidden">
    <nav aria-label="Navigazione mobile" class="contenitore flex flex-col py-3">
      {
        nav.map((voce) => (
          <a href={voce.href} class="border-b border-nero/8 py-3.5 font-sans text-base font-semibold text-nero last:border-0">
            {voce.label}
          </a>
        ))
      }
      <a href="/#preventivo" class="btn btn-nero mt-3 sm:hidden">Preventivo Gratuito</a>
      <a href={`tel:${site.phoneHref}`} class="mt-3 flex items-center gap-2.5 py-2 font-sans font-bold text-nero">
        <Icona nome="header-phone-call" class="size-4 text-taupe" />
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const testata = document.getElementById('testata')
  const bottone = document.getElementById('apri-menu')
  const menu = document.getElementById('menu-mobile')

  const aggiornaOmbra = () => {
    if (!testata) return
    testata.classList.toggle('shadow-[0_1px_0_rgba(21,22,19,0.10)]', window.scrollY > 8)
  }
  aggiornaOmbra()
  window.addEventListener('scroll', aggiornaOmbra, { passive: true })

  const chiudi = () => {
    if (!menu || !bottone) return
    menu.hidden = true
    bottone.setAttribute('aria-expanded', 'false')
  }

  bottone?.addEventListener('click', () => {
    if (!menu) return
    const aperto = !menu.hidden
    menu.hidden = aperto
    bottone.setAttribute('aria-expanded', String(!aperto))
  })

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', chiudi))
  document.addEventListener('keydown', (e) => e.key === 'Escape' && chiudi())
</script>
