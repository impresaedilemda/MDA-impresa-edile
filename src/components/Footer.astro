---
/**
 * Footer scuro del design: logo + descrizione + social a sinistra,
 * zona operativa e contatti diretti a destra, riga legale in basso.
 * Nota: nel design l'icona del bottone WhatsApp era un glifo "circle-x"
 * (artefatto dell'AI di Figma); qui usiamo il logo WhatsApp reale.
 */
import { anzianitaPubblicabile, denominazione, site, waLink } from '../config/site'
import { zoneSecondarie } from '../config/zone'
import { serviziPagine } from '../config/servizi-pagine'
import { guide } from '../config/guide'
import Icona from './Icona.astro'
import Logo from './Logo.astro'

const anno = new Date().getFullYear()

/** Il pulsante di revoca ha senso solo se c'e uno strumento da consentire. */
const conStatistiche = Boolean(site.gaId)

/* Il link al blog e fisso, come la voce nel menu (dall'11/09/2026). */
const blogAttivo = true

/**
 * Dati societari dell'art. 2250 c.c. (esteso allo spazio elettronico dal
 * comma 7): sede legale, P.IVA e C.F., registro delle imprese con numero REA,
 * capitale sociale, piu la PEC.
 *
 * Regola: un valore ancora segnaposto NON si pubblica come dato di fatto,
 * perche una P.IVA o un REA inventati sono peggio di un campo assente. Finche
 * il cliente non manda i dati veri, la voce semplicemente non compare.
 */
function eSegnaposto(valore: string): boolean {
  const v = valore.trim().toLowerCase()
  return v === '' || v.includes('esempio') || v.includes('your-') || /0{6,}/.test(v)
}

/* Dal 9 settembre 2026 questi tre campi vivono in src/config/site.ts e si
   possono anche scrivere dal pannello. Restano stringhe vuote finche il
   cliente non manda la visura: una voce vuota semplicemente non compare. */
const { registroImprese, capitaleSociale, pec } = site

const datiSocietari = [
  !eSegnaposto(site.street) && !eSegnaposto(site.postalCode)
    ? `Sede legale: ${site.street}, ${site.postalCode} ${site.city} (${site.province})`
    : '',
  !eSegnaposto(site.vat) ? `P.IVA e C.F. ${site.vat.replace('IT', '')}` : '',
  !eSegnaposto(site.rea)
    ? registroImprese
      ? `Iscritta al ${registroImprese}, REA ${site.rea}`
      : `REA ${site.rea}`
    : '',
  !eSegnaposto(capitaleSociale) ? `Capitale sociale ${capitaleSociale}` : '',
  !eSegnaposto(pec) ? `PEC ${pec}` : '',
].filter(Boolean)
---

<footer class="bg-nero text-white">
  <div class="contenitore pb-24 pt-16 md:py-[100px]">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1fr] lg:gap-12">
      <!-- Azienda -->
      <div class="flex flex-col gap-6">
        <Logo variante="chiaro" class="h-16 w-auto" />

        {/* "Dal 2009" e una affermazione di fatto sull'anzianita dell'impresa:
            esce solo se il cliente ha confermato l'anno di fondazione
            (site.foundedYearConfermato). Altrimenti la frase funziona lo
            stesso, senza la data. */}
        <p class="max-w-sm font-sans text-[15px] leading-relaxed text-sabbia/80">
          {anzianitaPubblicabile ? `Dal ${site.foundedYear} specializzati` : 'Specializzati'} esclusivamente
          nella progettazione, posa, manutenzione e rifacimento di coperture residenziali e industriali
          in {site.region}.
        </p>

        <div class="flex gap-3">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener"
            aria-label="Facebook di MDA Impresa Edile"
            class="flex size-11 items-center justify-center rounded-[4px] bg-white/7 transition-colors hover:bg-white hover:text-nero"
          >
            <Icona nome="footer-facebook" class="size-4" />
          </a>
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram di MDA Impresa Edile"
            class="flex size-11 items-center justify-center rounded-[4px] bg-white/7 transition-colors hover:bg-white hover:text-nero"
          >
            <Icona nome="footer-instagram" class="size-4" />
          </a>
        </div>
      </div>

      <!-- Servizi e guide -->
      <nav aria-label="Servizi e guide" class="flex flex-col gap-8">
        <div class="flex flex-col gap-5">
          <h2 class="font-sans text-xs font-extrabold uppercase tracking-[0.1em] text-white">Servizi</h2>
          <ul class="flex flex-col gap-3">
            {
              serviziPagine.map((s) => (
                <li>
                  <a href={`/servizi/${s.slug}/`} class="font-sans text-[15px] text-sabbia/80 transition-colors hover:text-white">
                    {s.h1.split(':')[0].split(',')[0]}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/servizi/" class="font-sans text-[13px] font-bold text-sabbia transition-colors hover:text-white">
                Tutti i servizi
              </a>
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-5">
          <h2 class="font-sans text-xs font-extrabold uppercase tracking-[0.1em] text-white">Guide</h2>
          <ul class="flex flex-col gap-3">
            {
              guide.slice(0, 4).map((g) => (
                <li>
                  <a href={`/guide/${g.slug}/`} class="font-sans text-[15px] text-sabbia/80 transition-colors hover:text-white">
                    {g.h1.split(':')[0]}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/guide/" class="font-sans text-[13px] font-bold text-sabbia transition-colors hover:text-white">
                Tutte le guide
              </a>
            </li>
            {
              blogAttivo && (
                <li>
                  <a href="/blog/" class="font-sans text-[13px] font-bold text-sabbia transition-colors hover:text-white">
                    Il blog
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </nav>

      <!-- Zona operativa -->
      <nav aria-label="Zona operativa" class="flex flex-col gap-5">
        <h2 class="font-sans text-xs font-extrabold uppercase tracking-[0.1em] text-white">Zona Operativa</h2>
        <ul class="flex flex-col gap-3">
          <li>
            <a href="/" class="font-sans text-[15px] text-sabbia/80 transition-colors hover:text-white">
              {site.city} e provincia
            </a>
          </li>
          {
            zoneSecondarie.map((zona) => (
              <li>
                <a href={`/zone/${zona.slug}/`} class="font-sans text-[15px] text-sabbia/80 transition-colors hover:text-white">
                  {zona.nome}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/zone/" class="font-sans text-[13px] font-bold text-sabbia transition-colors hover:text-white">
              Tutte le zone servite
            </a>
          </li>
        </ul>
      </nav>

      <!-- Contatti diretti -->
      <div class="flex flex-col gap-5">
        <h2 class="font-sans text-xs font-extrabold uppercase tracking-[0.1em] text-white">Contatti Diretti</h2>

        <a href={`tel:${site.phoneHref}`} class="flex items-center gap-3 font-sans text-lg font-bold text-white transition-colors hover:text-sabbia">
          <Icona nome="footer-phone" class="size-[18px]" />
          {site.phone}
        </a>

        <a
          href={waLink()}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 self-start rounded-[4px] bg-whatsapp/13 px-4 py-2.5 font-sans text-sm font-bold text-whatsapp transition-colors hover:bg-whatsapp hover:text-nero"
        >
          <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41a9.36 9.36 0 0 1 9.41 9.42c0 5.19-4.23 9.41-9.42 9.41ZM20.52 3.49A11.78 11.78 0 0 0 12.05 0C5.5 0 .18 5.32.17 11.86c0 2.09.55 4.13 1.59 5.93L.07 24l6.36-1.67a11.9 11.9 0 0 0 5.62 1.43h.01c6.54 0 11.86-5.32 11.87-11.86a11.8 11.8 0 0 0-3.41-8.41Z"></path>
          </svg>
          Scrivici su WhatsApp
        </a>

        <a href={`mailto:${site.email}`} class="flex items-center gap-3 font-sans text-[15px] text-sabbia/80 transition-colors hover:text-white">
          <Icona nome="footer-mail" class="size-[18px]" />
          {site.email}
        </a>

        <p class="mt-1 font-sans text-[13px] leading-relaxed text-sabbia/60">
          {
            !eSegnaposto(site.street) && !eSegnaposto(site.postalCode) ? (
              <>
                {/* Un'unica stringa: Astro mangia lo spazio fra due espressioni
                    e stampava "33170Pordenone". */}
                {`${site.street}, ${site.postalCode} ${site.city} (${site.province})`}
                <br />
              </>
            ) : (
              <>
                {site.city} ({site.province}) e provincia
                <br />
              </>
            )
          }
          {site.hours.label}
        </p>
      </div>
    </div>

    <!-- Riga legale -->
    <div class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 md:flex-row md:items-center md:justify-between">
      <p class="font-sans text-[13px] text-sabbia/60">
        &copy; {anno} {denominazione} · Tutti i diritti riservati.
        {
          datiSocietari.length > 0 && (
            <span class="mt-1 block text-sabbia/60">{datiSocietari.join(' | ')}</span>
          )
        }
      </p>
      <nav aria-label="Note legali" class="flex flex-wrap items-center gap-x-2 gap-y-1 font-sans text-[13px] text-sabbia/60">
        <a href="/privacy/" class="transition-colors hover:text-white">Privacy</a>
        <span aria-hidden="true">·</span>
        <a href="/cookie/" class="transition-colors hover:text-white">Cookie</a>
        <span aria-hidden="true">·</span>
        <a href="/termini/" class="transition-colors hover:text-white">Termini</a>
        <span aria-hidden="true">·</span>
        <a href="/recesso/" class="transition-colors hover:text-white">Recesso e rimborsi</a>
        <span aria-hidden="true">·</span>
        <a href="/crediti/" class="transition-colors hover:text-white">Crediti</a>
        {
          /* Revoca del consenso: obbligatoria e sempre raggiungibile, ma solo
             se c'e un consenso da revocare. Senza Google Analytics il
             pulsante non aprirebbe niente. */
          conStatistiche && (
            <>
              <span aria-hidden="true">·</span>
              <button
                type="button"
                data-apri-consenso
                class="underline underline-offset-2 transition-colors hover:text-white"
              >
                Gestisci i cookie
              </button>
            </>
          )
        }
      </nav>
    </div>
  </div>
</footer>
