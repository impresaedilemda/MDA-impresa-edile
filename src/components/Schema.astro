---
import { anzianitaPubblicabile, site } from '../config/site'
import { services, verniciatura, faqs } from '../config/content'
import { verificheLegali, problemiLegali } from '../config/legale'

interface Props {
  /** FAQPage della home: va dichiarata solo dove le domande sono visibili */
  conFaq?: boolean
}

const { conFaq = false } = Astro.props

/* La verniciatura nel design e un pannello di approfondimento, ma per lo
   schema resta un servizio a pieno titolo. */
const tuttiIServizi = [
  ...services.map((s) => ({ id: s.id, title: s.title, description: s.text, keyword: s.keyword })),
  {
    id: verniciatura.id,
    title: 'Verniciatura Tetto',
    description: verniciatura.intro,
    keyword: verniciatura.keyword,
  },
]

const base = site.url
const idAzienda = `${base}/#organizzazione`

/* ---------------------------------------------------------------------------
 *  DATI SEGNAPOSTO E DATI STRUTTURATI
 *  I motori di ricerca leggono questo blocco come dichiarazioni di fatto:
 *  un valore segnaposto qui non e un refuso, e un dato identificativo falso.
 *  Regola: se il dato non e confermato la chiave viene OMESSA, mai emessa
 *  col valore finto. L'unica fonte di verita su cosa sia segnaposto e
 *  src/config/legale.ts, cosi non si duplica la logica.
 * ------------------------------------------------------------------------ */

/** true solo se la verifica di quel campo in legale.ts e superata. */
const datoConfermato = (campo: string) => verificheLegali.find((v) => v.campo === campo)?.ok === true

/** Nessun campo obbligatorio e rimasto segnaposto. */
const datiLegaliCompleti = problemiLegali.length === 0

/** Include le chiavi solo se il dato e confermato, altrimenti le omette. */
const soloSe = (confermato: boolean, campi: Record<string, unknown>) => (confermato ? campi : {})

/** JSON.stringify non escapa "<": un "</script>" nei testi chiuderebbe il
 *  blocco in anticipo. U+2028 e U+2029 spezzano invece il parsing. */
const jsonLd = (dati: unknown) =>
  JSON.stringify(dati)
    .replace(/</g, '\\u003c')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029')

/**
 * RoofingContractor e il tipo più specifico disponibile per un'impresa
 * di coperture ed eredita da LocalBusiness. Descrive l'attività;
 * la presenza nei risultati locali dipende anche dal profilo dell'impresa.
 */
const azienda = {
  '@type': ['RoofingContractor', 'GeneralContractor'],
  '@id': idAzienda,
  name: site.name,
  /* legalName e foundingDate restano fuori finche la visura non conferma
     forma giuridica e anno: "S.r.l." e "2009" sono ancora segnaposto. */
  ...soloSe(datiLegaliCompleti && site.formaGiuridica !== 'da-confermare', { legalName: site.legalName }),
  /* foundingDate ha una condizione in piu: la visura puo essere completa e
     l'anno di fondazione restare quello scritto a mano. */
  ...soloSe(datiLegaliCompleti && anzianitaPubblicabile, { foundingDate: String(site.foundedYear) }),
  description: `Impresa edile specializzata in rifacimento, manutenzione, impermeabilizzazione e verniciatura di tetti a ${site.city}, in Veneto e Friuli-Venezia Giulia.`,
  url: base,
  telephone: site.phoneHref,
  email: site.email,
  image: `${base}/images/og-image.jpg`,
  /* Il logo deve essere il marchio, non una fotografia: apple-touch-icon.png
     e l'unico file marchiato presente in public/ (180x180, sopra il minimo
     di 112px richiesto da Google). */
  logo: {
    '@type': 'ImageObject',
    url: `${base}/apple-touch-icon.png`,
    width: 180,
    height: 180,
  },
  /* Una partita IVA inventata nei dati strutturati e un dato identificativo
     falso, non un semplice segnaposto: meglio assente. */
  ...soloSe(datoConfermato('Partita IVA'), { vatID: site.vat }),
  /* priceRange tolto: il cliente non vuole nessun posizionamento di prezzo,
     nemmeno simbolico, nei dati strutturati. */
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Bonifico bancario, Contanti',
  address: {
    '@type': 'PostalAddress',
    ...soloSe(datoConfermato('Sede legale'), { streetAddress: site.street }),
    addressLocality: site.city,
    addressRegion: site.province,
    postalCode: site.postalCode,
    addressCountry: 'IT',
  },
  /* Coordinate segnaposto significano uno spillo sulla mappa a un indirizzo
     che non e quello dell'impresa: si pubblicano solo a sede confermata. */
  ...soloSe(datiLegaliCompleti, {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.geo.lat,
      longitude: site.geo.lng,
    },
  }),
  areaServed: [
    ...site.regions.map((regione) => ({ '@type': 'AdministrativeArea', name: regione })),
    ...site.areaServed.map((comune) => ({ '@type': 'City', name: comune })),
  ],
  // Gli orari del pannello sono testo libero: non dichiariamo uno schema
  // fisso che potrebbe contraddire gli orari visibili nel footer.
  sameAs: [site.social.instagram, site.social.facebook],
  slogan: site.tagline,
  knowsAbout: tuttiIServizi.map((s) => s.keyword),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servizi di copertura e lattoneria',
    /* Ogni voce del catalogo ha una pagina dedicata: l'@id e lo stesso della
       pagina /servizi/<slug>/ cosi le due entita si fondono in una sola
       invece di duplicarsi. Gli id in content.ts coincidono con gli slug. */
    itemListElement: tuttiIServizi.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@id': `${base}/servizi/${s.id}/#servizio`,
        '@type': 'Service',
        name: s.title,
        url: `${base}/servizi/${s.id}/`,
      },
    })),
  },

}

const sitoWeb = {
  '@type': 'WebSite',
  '@id': `${base}/#sito`,
  url: base,
  name: site.name,
  inLanguage: 'it-IT',
  publisher: { '@id': idAzienda },
}

const paginaFaq = {
  '@type': 'FAQPage',
  '@id': `${base}/#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const grafo = {
  '@context': 'https://schema.org',
  '@graph': conFaq ? [azienda, sitoWeb, paginaFaq] : [azienda, sitoWeb],
}
---

<script type="application/ld+json" is:inline set:html={jsonLd(grafo)} />
