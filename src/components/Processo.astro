---
import { processSection, processSteps } from '../config/content'
import Icona from './Icona.astro'
---

<section id="processo" class="scroll-mt-24 bg-crema py-16 md:py-[120px]">
  <div class="contenitore flex flex-col gap-12 md:gap-20">
    <div class="rivela flex max-w-[800px] flex-col gap-4">
      <p class="occhiello">{processSection.eyebrow}</p>
      <h2 class="titolo-sezione">{processSection.title}</h2>
    </div>

    <ol class="rivela-fila grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        processSteps.map((passo) => (
          <li class="solleva flex flex-col gap-6 rounded-lg border border-nero/8 bg-carta p-8">
            <div class="flex items-start justify-between">
              <span class="font-display text-[2.5rem] font-semibold leading-none text-taupe">{passo.n}</span>
              <Icona nome={`how-we-work-${passo.icon}`} class="size-6 text-nero" />
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="font-sans text-lg font-bold text-nero">{passo.title}</h3>
              <p class="font-sans text-sm leading-relaxed text-nero/80">{passo.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
