---
/**
 * Pulsante fisso in basso a sinistra: apre un pannello con i canali di
 * contatto diretto. Solo da desktop, perche su mobile lo stesso lavoro
 * lo fa gia la barra fissa in fondo (BarraMobile).
 */
import { site, waLink } from '../config/site'
import Icona from './Icona.astro'
---

<div class="fixed bottom-7 left-7 z-40 hidden lg:block">
  <!-- Pannello -->
  <div
    id="pannello-rapido"
    hidden
    class="mb-3 w-[268px] origin-bottom-left overflow-hidden rounded-xl bg-crema shadow-[0_20px_50px_rgba(0,0,0,0.25)]"
  >
    <div class="border-b border-nero/8 px-5 py-4">
      <p class="font-display text-lg font-normal text-nero">Contatto rapido</p>
      <p class="mt-0.5 font-sans text-xs text-nero/60">{site.hours.label}</p>
    </div>

    <div class="flex flex-col p-2">
      <a
        href={`tel:${site.phoneHref}`}
        data-azione="chiamata"
        class="flex items-center gap-3 rounded-lg px-3 py-3 transition-colors hover:bg-sabbia"
      >
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-nero text-white">
          <Icona nome="footer-phone" class="size-4" />
        </span>
        <span class="flex flex-col">
          <span class="font-sans text-sm font-bold text-nero">Chiama ora</span>
          <span class="font-sans text-xs text-nero/60">{site.phone}</span>
        </span>
      </a>

      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        data-azione="whatsapp"
        class="flex items-center gap-3 rounded-lg px-3 py-3 transition-colors hover:bg-sabbia"
      >
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41a9.36 9.36 0 0 1 9.41 9.42c0 5.19-4.23 9.41-9.42 9.41ZM20.52 3.49A11.78 11.78 0 0 0 12.05 0C5.5 0 .18 5.32.17 11.86c0 2.09.55 4.13 1.59 5.93L.07 24l6.36-1.67a11.9 11.9 0 0 0 5.62 1.43h.01c6.54 0 11.86-5.32 11.87-11.86a11.8 11.8 0 0 0-3.41-8.41Z"
            ></path>
          </svg>
        </span>
        <span class="flex flex-col">
          <span class="font-sans text-sm font-bold text-nero">WhatsApp</span>
          <span class="font-sans text-xs text-nero/60">Risposta rapida</span>
        </span>
      </a>

      <a
        href={`mailto:${site.email}`}
        data-azione="email"
        class="flex items-center gap-3 rounded-lg px-3 py-3 transition-colors hover:bg-sabbia"
      >
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-taupe text-white">
          <Icona nome="footer-mail" class="size-4" />
        </span>
        <span class="flex flex-col">
          <span class="font-sans text-sm font-bold text-nero">Email</span>
          <span class="font-sans text-xs text-nero/60">{site.email}</span>
        </span>
      </a>

      <a
        href="#preventivo"
        data-azione="preventivo"
        class="mt-1 flex items-center justify-center rounded-lg bg-nero px-3 py-3 font-sans text-[13px] font-bold uppercase tracking-[0.04em] text-white transition-colors hover:bg-nero-2"
      >
        Preventivo gratuito
      </a>
    </div>
  </div>

  <!-- Pulsante -->
  <button
    type="button"
    id="apri-rapido"
    aria-expanded="false"
    aria-controls="pannello-rapido"
    class="group flex items-center gap-3 rounded-full bg-nero py-3.5 pl-4 pr-5 text-white shadow-[0_10px_30px_rgba(0,0,0,0.3)] transition-all hover:bg-nero-2"
  >
    <span class="relative flex size-6 items-center justify-center">
      <!-- Icona chat, visibile a pannello chiuso -->
      <svg
        id="icona-chat"
        class="absolute size-5 transition-all duration-200"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4-.9L3 21l1.9-4.6a8.4 8.4 0 0 1-.9-4A8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"></path>
      </svg>
      <!-- Icona chiusura, visibile a pannello aperto -->
      <svg
        id="icona-chiudi"
        class="absolute size-5 scale-0 opacity-0 transition-all duration-200"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </span>
    <span class="font-sans text-[13px] font-bold uppercase tracking-[0.04em]">Contatto rapido</span>
    <!-- Pallino di disponibilita -->
    <span class="relative flex size-2 shrink-0">
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-verde opacity-70"></span>
      <span class="relative inline-flex size-2 rounded-full bg-verde"></span>
    </span>
  </button>
</div>

<script>
  const pulsante = document.getElementById('apri-rapido')
  const pannello = document.getElementById('pannello-rapido')
  const iconaChat = document.getElementById('icona-chat')
  const iconaChiudi = document.getElementById('icona-chiudi')

  if (pulsante && pannello && iconaChat && iconaChiudi) {
    const imposta = (aperto: boolean) => {
      pannello.hidden = !aperto
      pulsante.setAttribute('aria-expanded', String(aperto))
      iconaChat.classList.toggle('scale-0', aperto)
      iconaChat.classList.toggle('opacity-0', aperto)
      iconaChiudi.classList.toggle('scale-0', !aperto)
      iconaChiudi.classList.toggle('opacity-0', !aperto)
    }

    pulsante.addEventListener('click', (e) => {
      e.stopPropagation()
      imposta(pannello.hidden)
    })

    // Chiusura: click fuori, Escape, o scelta di un canale
    document.addEventListener('click', (e) => {
      if (!pannello.hidden && !pannello.contains(e.target as Node)) imposta(false)
    })
    document.addEventListener('keydown', (e) => e.key === 'Escape' && imposta(false))

    pannello.querySelectorAll<HTMLAnchorElement>('[data-azione]').forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || []
        window.dataLayer.push({ event: 'contatto_diretto', canale: link.dataset.azione })
        imposta(false)
      })
    })
  }
</script>
