---
/**
 * Barra fissa mobile del design: fondo bianco, due pulsanti uguali.
 * "Chiama Ora" scuro + "WhatsApp" verde. Compare dopo la prima schermata.
 * Nota: l'icona WhatsApp del design era un glifo "circle-x" (artefatto
 * dell'AI di Figma); qui usiamo il logo WhatsApp reale.
 */
import { site, waLink } from '../config/site'
import Icona from './Icona.astro'
---

<div
  id="barra-mobile"
  class="fixed inset-x-0 bottom-0 z-50 translate-y-full border-t border-nero/8 bg-white transition-transform duration-300 lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="flex items-center gap-3 px-4 py-3">
    <a
      href={`tel:${site.phoneHref}`}
      class="flex flex-1 items-center justify-center gap-2 rounded-[6px] bg-nero p-3.5 font-sans text-sm font-extrabold uppercase text-white active:opacity-85"
      data-azione="chiamata"
    >
      <Icona nome="mobile-sticky-bar-1" class="size-4" />
      Chiama Ora
    </a>

    <a
      href={waLink()}
      target="_blank"
      rel="noopener"
      class="flex flex-1 items-center justify-center gap-2 rounded-[6px] bg-whatsapp p-3.5 font-sans text-sm font-extrabold uppercase text-white active:opacity-85"
      data-azione="whatsapp"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41a9.36 9.36 0 0 1 9.41 9.42c0 5.19-4.23 9.41-9.42 9.41ZM20.52 3.49A11.78 11.78 0 0 0 12.05 0C5.5 0 .18 5.32.17 11.86c0 2.09.55 4.13 1.59 5.93L.07 24l6.36-1.67a11.9 11.9 0 0 0 5.62 1.43h.01c6.54 0 11.86-5.32 11.87-11.86a11.8 11.8 0 0 0-3.41-8.41Z"></path>
      </svg>
      WhatsApp
    </a>
  </div>
</div>

<script>
  const barra = document.getElementById('barra-mobile')

  if (barra) {
    const aggiorna = () => {
      barra.classList.toggle('translate-y-full', window.scrollY < window.innerHeight * 0.6)
    }

    // La barra e lg:hidden: sopra i 1024px non si rende, quindi il listener
    // di scroll non serve. matchMedia e non resize, cosi scatta una volta sola.
    const desktop = matchMedia('(min-width: 1024px)')
    const sincronizza = (mobile: boolean) => {
      if (mobile) {
        aggiorna()
        window.addEventListener('scroll', aggiorna, { passive: true })
      } else {
        window.removeEventListener('scroll', aggiorna)
      }
    }
    sincronizza(!desktop.matches)
    desktop.addEventListener('change', (e) => sincronizza(!e.matches))

    barra.querySelectorAll<HTMLAnchorElement>('[data-azione]').forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || []
        window.dataLayer.push({ event: 'contatto_diretto', canale: link.dataset.azione })
      })
    })
  }
</script>
