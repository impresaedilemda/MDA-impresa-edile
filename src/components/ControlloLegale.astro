---
/**
 * Pannello di controllo dei dati legali. Compare SOLO in sviluppo e non
 * finisce mai nel sito pubblicato: serve a non dimenticare un segnaposto
 * il giorno della pubblicazione.
 */
import { problemiLegali, avvisaSeIncompleto } from '../config/legale'
import { portfolioIsPlaceholder, reviewsArePlaceholder } from '../config/content'
import { listinoConfermato } from '../config/calcolatore'
import { site } from '../config/site'

// Il pannello è montato nel layout, quindi il componente gira su ogni pagina:
// l'avviso in console va stampato una volta sola per build.
const globale = globalThis as unknown as { __mdaAvvisoLegale?: boolean }
if (!globale.__mdaAvvisoLegale) {
  globale.__mdaAvvisoLegale = true
  avvisaSeIncompleto()
}

const contenutiFinti = [
  portfolioIsPlaceholder &&
    'Portfolio: le coppie prima/dopo sono nostre illustrazioni. La sezione lo dichiara con un avviso visibile e le etichette dicono "tipico". Con le foto vere si mette portfolioIsPlaceholder a false.',
  reviewsArePlaceholder &&
    'Recensioni: la sezione non esiste finche non ce ne sono di vere. NON rimettere recensioni scritte da noi (allegato I Codice del consumo, d.lgs. 26/2023).',
  !listinoConfermato && 'Listino del calcolatore di stima: intervalli di mercato da far rivedere al cliente (src/config/calcolatore.ts)',
  !site.foundedYearConfermato &&
    `Anno di fondazione non confermato: "dal ${site.foundedYear}" e "da N anni" restano nascosti ovunque (site.foundedYearConfermato).`,
  site.formaGiuridica === 'da-confermare' &&
    'Forma giuridica da confermare con la visura: se e una S.r.l. serve anche il capitale sociale versato in footer (art. 2250 c.c.).',
  !site.gaId &&
    'PUBLIC_GA_ID non impostato: nessun Google Analytics e nessun banner cookie. Appena la variabile esiste su Vercel, il banner compare da solo.',
].filter(Boolean)

const tutto = problemiLegali.length + contenutiFinti.length
---

{
  import.meta.env.DEV && tutto > 0 && (
    <details class="fixed bottom-4 right-4 z-[100] w-[380px] max-w-[calc(100vw-2rem)] rounded-lg border-2 border-red-500 bg-white text-sm shadow-2xl">
      <summary class="cursor-pointer list-none px-5 py-3 font-sans text-[13px] font-bold text-red-700">
        Da completare prima di pubblicare ({tutto})
      </summary>

      <div class="max-h-[70vh] overflow-auto px-5 pb-5">
      <p class="font-sans text-xs text-neutral-500">
        Pannello visibile solo in sviluppo, non finisce in produzione.
      </p>

      {problemiLegali.length > 0 && (
        <>
          <p class="mt-4 font-sans text-xs font-bold uppercase tracking-wide text-red-700">
            Dati obbligatori per legge
          </p>
          <ul class="mt-2 flex flex-col gap-2.5">
            {problemiLegali.map((p) => (
              <li class="border-l-2 border-red-400 pl-3">
                <p class="font-sans text-[13px] font-semibold text-neutral-900">{p.campo}</p>
                <p class="font-mono text-[11px] text-red-600">{p.valore || '(vuoto)'}</p>
                <p class="mt-0.5 font-sans text-[11px] leading-snug text-neutral-600">{p.perche}</p>
              </li>
            ))}
          </ul>
        </>
      )}

      {contenutiFinti.length > 0 && (
        <>
          <p class="mt-4 font-sans text-xs font-bold uppercase tracking-wide text-amber-700">
            Contenuti segnaposto
          </p>
          <ul class="mt-2 flex flex-col gap-1.5">
            {contenutiFinti.map((c) => (
              <li class="border-l-2 border-amber-400 pl-3 font-sans text-[12px] text-neutral-700">{c}</li>
            ))}
          </ul>
          <p class="mt-2 font-sans text-[11px] leading-snug text-neutral-600">
            Lavori e recensioni inventati sono pubblicità ingannevole (Codice del Consumo) e violano
            le linee guida di Google.
          </p>
        </>
      )}

      <p class="mt-4 border-t border-neutral-200 pt-3 font-sans text-[11px] leading-snug text-neutral-500">
        Si completa in <code class="font-mono">src/config/site.ts</code> e{' '}
        <code class="font-mono">src/config/content.ts</code>. Checklist completa in CLIENT-DATA.md.
      </p>
      </div>
    </details>
  )
}

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
