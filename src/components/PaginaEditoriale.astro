---
/**
 * Corpo condiviso delle pagine guida e servizio: intestazione scura,
 * breadcrumb, sezioni di testo, FAQ con schema, collegamenti correlati
 * e chiusura con invito al preventivo. Stile identico alla home.
 */
import { site } from '../config/site'
import type { PaginaSEO } from '../config/guide'
import { guidaPerSlug } from '../config/guide'
import { servizioPerSlug } from '../config/servizi-pagine'
import Icona from './Icona.astro'

interface Props {
  pagina: PaginaSEO
  /** 'guide' o 'servizi': determina breadcrumb e percorso */
  radice: 'guide' | 'servizi'
  etichettaRadice: string
}

const { pagina, radice, etichettaRadice } = Astro.props

const correlatiServizi = pagina.correlati.servizi
  .map((s) => servizioPerSlug(s))
  .filter(Boolean)
const correlatiGuide = pagina.correlati.guide.map((g) => guidaPerSlug(g)).filter(Boolean)
---

<main id="contenuto">
  <!-- Intestazione scura -->
  <section class="bg-nero py-14 text-white md:py-20">
    <div class="contenitore flex max-w-[900px] flex-col gap-5">
      <nav aria-label="Percorso" class="font-sans text-[13px] text-sabbia/60">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span aria-hidden="true" class="mx-2">·</span>
        <a href={`/${radice}/`} class="transition-colors hover:text-white">{etichettaRadice}</a>
      </nav>
      <p class="occhiello !text-sabbia">{pagina.eyebrow}</p>
      <h1 class="font-display text-4xl font-light leading-[1.1] md:text-5xl">{pagina.h1}</h1>
      <p class="max-w-[760px] font-sans text-lg leading-relaxed text-sabbia/85">{pagina.intro}</p>

      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <a href="/#preventivo" class="btn btn-bianco !px-7 !py-4">Preventivo gratuito</a>
        <a href={`tel:${site.phoneHref}`} class="btn btn-contorno-scuro !px-7 !py-4">
          <Icona nome="hero-phone-call" class="size-4" />
          {site.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Corpo -->
  <section class="bg-crema py-14 md:py-20">
    <div class="contenitore grid gap-14 lg:grid-cols-[minmax(0,760px)_1fr] lg:gap-20">
      <article class="flex flex-col gap-12">
        {
          pagina.sezioni.map((sezione) => (
            <section class="rivela flex flex-col gap-4">
              <h2 class="font-display text-[1.75rem] font-normal leading-snug text-nero md:text-[2rem]">
                {sezione.h2}
              </h2>
              {sezione.paragrafi.map((p) => (
                <p class="font-sans text-[15px] leading-[1.8] text-nero/80">{p}</p>
              ))}
            </section>
          ))
        }

        <!-- FAQ della pagina -->
        <section class="rivela flex flex-col gap-5 border-t border-nero/12 pt-10">
          <h2 class="font-display text-[1.75rem] font-normal leading-snug text-nero md:text-[2rem]">
            Domande frequenti
          </h2>
          <div class="flex flex-col gap-4">
            {
              pagina.faq.map((f, i) => (
                <details class="group rounded-lg bg-carta" name="faq-pagina" open={i === 0}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 font-display text-[1.2rem] font-semibold text-nero transition-colors hover:text-taupe">
                    <h3 class="text-[1.2rem] font-semibold leading-snug">{f.q}</h3>
                    <span class="flex size-5 shrink-0 items-center justify-center" aria-hidden="true">
                      <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M4 10h12" />
                        <path class="transition-transform duration-300 [transform-origin:center] group-open:scale-y-0" d="M10 4v12" />
                      </svg>
                    </span>
                  </summary>
                  <div class="px-6 pb-5">
                    <p class="font-sans text-[15px] leading-relaxed text-nero/80">{f.a}</p>
                  </div>
                </details>
              ))
            }
          </div>
        </section>
      </article>

      <!-- Colonna laterale -->
      <aside class="flex flex-col gap-8 lg:sticky lg:top-28 lg:self-start">
        {
          correlatiServizi.length > 0 && (
            <div class="rounded-lg border border-nero/8 bg-carta p-7">
              <h2 class="font-sans text-xs font-extrabold uppercase tracking-[0.1em] text-taupe">
                Servizi collegati
              </h2>
              <ul class="mt-4 flex flex-col gap-3">
                {correlatiServizi.map((s) => (
                  <li>
                    <a
                      href={`/servizi/${s!.slug}/`}
                      class="group flex items-center justify-between gap-3 font-sans text-[15px] font-semibold text-nero transition-colors hover:text-taupe"
                    >
                      {s!.h1.split(':')[0].split(',')[0]}
                      <Icona nome="services-arrow-right" class="size-3.5 shrink-0 text-taupe transition-transform group-hover:translate-x-1" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          correlatiGuide.length > 0 && (
            <div class="rounded-lg border border-nero/8 bg-carta p-7">
              <h2 class="font-sans text-xs font-extrabold uppercase tracking-[0.1em] text-taupe">
                Guide utili
              </h2>
              <ul class="mt-4 flex flex-col gap-3">
                {correlatiGuide.map((g) => (
                  <li>
                    <a
                      href={`/guide/${g!.slug}/`}
                      class="group flex items-center justify-between gap-3 font-sans text-[15px] font-semibold text-nero transition-colors hover:text-taupe"
                    >
                      {g!.h1.split(':')[0]}
                      <Icona nome="services-arrow-right" class="size-3.5 shrink-0 text-taupe transition-transform group-hover:translate-x-1" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="rounded-lg bg-nero p-7 text-white">
          <p class="font-display text-xl font-normal leading-snug">Un dubbio sul vostro tetto?</p>
          <p class="mt-2 font-sans text-sm leading-relaxed text-sabbia/75">
            Sopralluogo e preventivo scritto gratuiti fra {site.regions[0]} e {site.regions[1]}.
          </p>
          <a href="/#preventivo" class="btn btn-bianco mt-5 w-full !shadow-none">Preventivo gratuito</a>
          <a
            href={`tel:${site.phoneHref}`}
            class="mt-3 block text-center font-sans text-sm font-bold text-sabbia underline-offset-4 hover:underline"
          >
            {site.phone}
          </a>
        </div>
      </aside>
    </div>
  </section>
</main>
