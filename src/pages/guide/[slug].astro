---
/**
 * Pagina guida: articolo di approfondimento con schema Article,
 * FAQPage e BreadcrumbList propri.
 */
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import BarraMobile from '../../components/BarraMobile.astro'
import ContattoRapido from '../../components/ContattoRapido.astro'
import PaginaEditoriale from '../../components/PaginaEditoriale.astro'
import { site } from '../../config/site'
import { guide } from '../../config/guide'

export function getStaticPaths() {
  return guide.map((pagina) => ({ params: { slug: pagina.slug }, props: { pagina } }))
}

const { pagina } = Astro.props

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: pagina.h1,
      description: pagina.metaDescription,
      inLanguage: 'it-IT',
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@id': `${site.url}/#organizzazione` },
      mainEntityOfPage: `${site.url}/guide/${pagina.slug}/`,
    },
    {
      '@type': 'FAQPage',
      mainEntity: pagina.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Guide', item: `${site.url}/guide/` },
        { '@type': 'ListItem', position: 3, name: pagina.h1, item: `${site.url}/guide/${pagina.slug}/` },
      ],
    },
  ],
}
---

<Base title={pagina.metaTitle} description={pagina.metaDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <Header />
  <PaginaEditoriale pagina={pagina} radice="guide" etichettaRadice="Guide" />
  <Footer />
  <BarraMobile />
  <ContattoRapido />
</Base>
