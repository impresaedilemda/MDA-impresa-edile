---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import BarraMobile from '../../components/BarraMobile.astro'
import ContattoRapido from '../../components/ContattoRapido.astro'
import Icona from '../../components/Icona.astro'
import { site } from '../../config/site'
import { zoneSecondarie } from '../../config/zone'

const title = `Zone Servite | Tetti a ${site.city} e Provincia | ${site.name}`
const description = `Interveniamo su tetti e coperture a ${site.city} e in tutta la provincia di ${site.province}: ${zoneSecondarie
  .slice(0, 4)
  .map((z) => z.nome)
  .join(', ')} e comuni limitrofi.`
---

<Base title={title} description={description}>
  <Header />

  <main id="contenuto">
    <section class="bg-crema py-16 md:py-[100px]">
      <div class="contenitore flex flex-col gap-12">
        <div class="flex max-w-[800px] flex-col gap-4">
          <p class="occhiello">Zona operativa</p>
          <h1 class="titolo-sezione">Dove interveniamo in provincia di {site.province}</h1>
          <p class="max-w-[640px] font-sans leading-relaxed text-nero/80">
            La base operativa è a {site.city}, ma la squadra lavora ogni settimana in tutta la
            provincia. Qui trovate le pagine dedicate ai principali comuni serviti; se il vostro non
            c'è, chiamateci comunque: per i cantieri di dimensioni rilevanti valutiamo anche zone più
            distanti.
          </p>
        </div>

        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <!-- La citta principale punta alla home -->
          <li>
            <a
              href="/"
              class="group flex h-full flex-col gap-2 rounded-lg bg-nero p-7 text-white transition-transform hover:-translate-y-0.5"
            >
              <span class="font-display text-2xl font-normal">{site.city}</span>
              <span class="font-sans text-[13px] text-sabbia/70">Base operativa · vai alla pagina principale</span>
              <Icona nome="services-arrow-right" class="mt-2 size-4 text-sabbia transition-transform group-hover:translate-x-1" />
            </a>
          </li>
          {
            zoneSecondarie.map((zona) => (
              <li>
                <a
                  href={`/zone/${zona.slug}/`}
                  class="group flex h-full flex-col gap-2 rounded-lg border border-nero/8 bg-white p-7 transition-transform hover:-translate-y-0.5"
                >
                  <span class="font-display text-2xl font-normal text-nero">{zona.nome}</span>
                  <span class="font-sans text-[13px] text-nero/60">Rifacimento, manutenzione, guaine e verniciatura</span>
                  <Icona nome="services-arrow-right" class="mt-2 size-4 text-taupe transition-transform group-hover:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>

        <p class="max-w-[640px] font-sans text-sm leading-relaxed text-nero/60">
          Il vostro comune non è in elenco? Scriveteci su WhatsApp o chiamate lo
          <a href={`tel:${site.phoneHref}`} class="font-bold text-nero underline underline-offset-2">{site.phone}</a>:
          vi diciamo subito se rientrate nella zona di intervento.
        </p>
      </div>
    </section>
  </main>

  <Footer />
  <BarraMobile />
  <ContattoRapido />
</Base>
