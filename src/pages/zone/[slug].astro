---
/**
 * Pagina locale per comune: "Rifacimento e manutenzione tetti a <Comune>".
 * Generata staticamente per ogni comune in site.areaServed (tranne la citta
 * principale, coperta dalla home).
 */
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import BarraMobile from '../../components/BarraMobile.astro'
import ContattoRapido from '../../components/ContattoRapido.astro'
import Icona from '../../components/Icona.astro'
import { anzianitaPubblicabile, site, yearsActive, waLink } from '../../config/site'
import { services, verniciatura } from '../../config/content'
import { zoneSecondarie } from '../../config/zone'
import { articoliBlog } from '../../lib/articoli-blog'
import { guidaPerSlug } from '../../config/guide'
import { jsonLd } from '../../lib/blog-cliente'

export function getStaticPaths() {
  return zoneSecondarie.map((zona) => ({ params: { slug: zona.slug }, props: { zona } }))
}

const { zona } = Astro.props

const title = `Riparazione e rifacimento tetti ${zona.nome} | MDA`
const description = `Riparazione, rifacimento tetti e grondaie a ${zona.nome}. MDA: sopralluogo gratuito e preventivo per il tuo immobile, con costi e lavorazioni da valutare.`
const guida = guidaPerSlug(zona.approfondimento.guida)
const articolo = articoliBlog.find((a) => a.slug === zona.approfondimento.blog)

/* Le tre FAQ piu utili per chi arriva da una ricerca locale */
const faqLocali = [
  {
    q: `Quanto costa riparare un tetto a ${zona.nome}?`,
    a: 'Il costo dipende dalla causa del problema, dalla superficie interessata, dai materiali e dall’accessibilità. Una riparazione localizzata e un rifacimento completo sono interventi diversi. Il sopralluogo permette di definire le lavorazioni e formulare un preventivo scritto; una cifra al metro quadrato senza questi dati non è un’offerta riferita al vostro immobile.',
  },
  {
    q: `Avete una sede a ${zona.nome}?`,
    a: `La sede di MDA è a ${site.city}, in ${site.street}. ${zona.nome} è una zona servita, non una sede aggiuntiva. Indicate l’indirizzo dell’immobile per organizzare la visita e verificare la disponibilità.`,
  },
  {
    q: 'Il sopralluogo e il preventivo sono gratuiti?',
    a: 'Sì, il sopralluogo e il preventivo sono gratuiti e senza impegno. Nella richiesta indicate il comune, il tipo di copertura e il problema osservato. Fotografie disponibili e informazioni sui lavori precedenti aiutano a preparare la visita.',
  },
]

const tuttiIServizi = [
  ...services,
  { id: verniciatura.id, title: 'Verniciatura Tetto', text: verniciatura.intro, image: verniciatura.image, alt: verniciatura.alt },
]

/* Breadcrumb per Google: Home > Zone > Comune */
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Zone servite', item: `${site.url}/zone/` },
    { '@type': 'ListItem', position: 3, name: zona.nome, item: `${site.url}/zone/${zona.slug}/` },
  ],
}
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd(breadcrumb)} />
  </Fragment>

  <Header />

  <main id="contenuto">
    <!-- Intestazione locale -->
    <section class="bg-nero py-16 text-white md:py-24">
      <div class="contenitore">
        <nav aria-label="Percorso" class="font-sans text-[13px] text-sabbia/60">
          <a href="/" class="transition-colors hover:text-white">Home</a>
          <span aria-hidden="true" class="mx-2">·</span>
          <a href="/zone/" class="transition-colors hover:text-white">Zone servite</a>
          <span aria-hidden="true" class="mx-2">·</span>
          <span class="text-sabbia">{zona.nome}</span>
        </nav>

        <h1 class="mt-6 max-w-[900px] font-display text-4xl font-light leading-[1.1] md:text-[3.5rem]">
          Riparazione e rifacimento tetti a
          <em class="font-normal italic text-sabbia">{zona.nome}</em>
        </h1>

        <p class="mt-6 max-w-[720px] font-sans text-lg leading-relaxed text-crema">
          {anzianitaPubblicabile ? `Da ${yearsActive} anni la` : 'La'} nostra squadra interna interviene
          anche a {zona.nome} e nei comuni vicini: rifacimenti completi, riparazioni,
          impermeabilizzazioni, lattonerie e verniciature.
          {zona.taglio}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/#preventivo" class="btn btn-bianco !px-7 !py-4">Preventivo gratuito</a>
          <a href={`tel:${site.phoneHref}`} class="btn btn-contorno-scuro !px-7 !py-4">
            <Icona nome="hero-phone-call" class="size-4" />
            {site.phone}
          </a>
        </div>
      </div>
    </section>

    <!-- Servizi disponibili nel comune -->
    <section class="bg-crema py-16 md:py-24">
      <div class="contenitore flex flex-col gap-10">
        <div class="flex max-w-[800px] flex-col gap-4">
          <p class="occhiello">Cosa facciamo a {zona.nome}</p>
          <h2 class="titolo-sezione">Tutti gli interventi sulle coperture</h2>
        </div>

        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            tuttiIServizi.map((s) => (
              <li class="flex flex-col gap-3 rounded-lg border border-nero/8 bg-white p-7">
                <h3 class="font-display text-2xl font-normal text-nero">{s.title}</h3>
                <p class="flex-1 font-sans text-[14px] leading-relaxed text-nero/75">{s.text}</p>
                {/* Il collegamento va alla pagina del servizio, non all'ancora
                    della home: e quella pagina che deve posizionarsi. Il testo
                    del link porta il servizio e il comune. */}
                <a
                  href={`/servizi/${s.id}/`}
                  class="group inline-flex items-center gap-2 font-sans text-[13px] font-bold uppercase tracking-[0.04em] text-taupe transition-colors hover:text-nero"
                >
                  {s.title} a {zona.nome}
                  <Icona nome="services-arrow-right" class="size-3.5 transition-transform group-hover:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Come funziona + FAQ locali -->
    <section class="bg-sabbia py-16 md:py-24">
      <div class="contenitore grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col gap-6">
          <p class="occhiello">Come funziona</p>
          <h2 class="titolo-sezione">Sopralluogo gratuito a {zona.nome}</h2>
          <p class="max-w-[520px] font-sans leading-relaxed text-nero/80">
            Valutiamo condizioni e accessibilità della copertura per individuare le verifiche e
            le lavorazioni necessarie. La proposta distingue materiali, interventi ed eventuali
            esclusioni. Sopralluogo e preventivo sono gratuiti e senza impegno; tempi e disponibilità
            vengono concordati per il vostro immobile.
          </p>
          <a href="/guide/costo-rifacimento-tetto/" class="font-sans text-sm font-bold text-taupe underline underline-offset-4">
            Da cosa dipende il costo del tetto
          </a>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href="/#preventivo" class="btn btn-nero !px-7 !py-4">Richiedi il sopralluogo</a>
            <a href={waLink(`Buongiorno, vorrei un sopralluogo a ${zona.nome}.`)} target="_blank" rel="noopener" class="btn !px-7 !py-4 bg-whatsapp text-white hover:opacity-90">
              WhatsApp
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          {
            faqLocali.map((faq, i) => (
              <details class="rounded-lg bg-crema" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-6 py-5 font-display text-lg font-semibold text-nero">
                  {faq.q}
                  <svg class="size-4 shrink-0 text-taupe" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 10h12M10 4v12" />
                  </svg>
                </summary>
                <p class="px-6 pb-6 font-sans text-[14px] leading-relaxed text-nero/80">{faq.a}</p>
              </details>
            ))
          }
          <a href="/guide/" class="mt-1 font-sans text-sm font-bold text-taupe underline-offset-4 hover:underline">
            Leggi le guide tecniche
          </a>
        </div>
      </div>
    </section>

    <section class="bg-carta py-14 md:py-20">
      <div class="contenitore flex max-w-[900px] flex-col gap-5">
        <p class="occhiello">Preparare i lavori</p>
        <h2 class="titolo-sezione">{zona.approfondimento.titolo}</h2>
        {zona.approfondimento.paragrafi.map((testo) => <p class="font-sans text-[15px] leading-[1.8] text-nero/80">{testo}</p>)}
        <nav aria-label="Approfondimenti per questa zona" class="flex flex-col gap-3 border-t border-nero/10 pt-6 font-sans text-sm font-semibold text-taupe">
          {guida && <a class="underline underline-offset-4" href={`/guide/${guida.slug}/`}>{guida.h1}</a>}
          {articolo && <a class="underline underline-offset-4" href={`/blog/${articolo.slug}/`}>{articolo.titolo}</a>}
          <a class="underline underline-offset-4" href="/zone/">Consulta tutte le zone servite</a>
        </nav>
      </div>
    </section>
  </main>

  <Footer />
  <BarraMobile />
  <ContattoRapido />
</Base>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
